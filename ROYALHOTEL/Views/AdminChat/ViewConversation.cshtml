@using ROYALHOTEL.Models
@{
    ViewData["Title"] = "Conversation Detail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var conversation = ViewBag.Conversation as ChatConversation;
    var messages = ViewBag.Messages as List<ChatMessage> ?? new List<ChatMessage>();
}

<div class="section-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Conversation: @conversation?.ConversationCode</h4>
            <p class="text-muted mb-0">
                @if (conversation?.Account != null)
                {
                    <span>User: @conversation.Account.FullName (@conversation.Account.Email)</span>
                }
                else if (!string.IsNullOrEmpty(conversation?.GuestName))
                {
                    <span>Guest: @conversation.GuestName (@conversation.GuestEmail)</span>
                }
                else
                {
                    <span>Anonymous Guest</span>
                }
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(conversation?.EscalationReason))
    {
        <div class="alert alert-warning">
            <strong>Escalation Reason:</strong> @conversation.EscalationReason
        </div>
    }

    <!-- Contact Information Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Contact Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <strong>Name:</strong>
                    <p>@(conversation?.GuestName ?? "N/A")</p>
                </div>

                @if (conversation?.AccountId == null)
                {
                    <!-- Guest user -->
                    <div class="col-md-6">
                        <strong>Phone:</strong>
                        <p>
                            @if (!string.IsNullOrEmpty(conversation?.GuestPhone))
                            {
                                <a href="tel:@conversation.GuestPhone">
                                    <i class="bi bi-telephone"></i> @conversation.GuestPhone
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <strong>Email:</strong>
                        <p>
                            @if (!string.IsNullOrEmpty(conversation?.GuestEmail))
                            {
                                <a href="mailto:@conversation.GuestEmail">
                                    @conversation.GuestEmail
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-12">
                        <span class="badge bg-secondary">Guest User</span>
                    </div>
                }
                else
                {
                    <!-- Logged-in user -->
                    <div class="col-md-6">
                        <strong>Email:</strong>
                        <p>
                            <a href="mailto:@conversation?.Account?.Email">
                                @conversation?.Account?.Email
                            </a>
                        </p>
                    </div>
                    <div class="col-md-12">
                        <span class="badge bg-success">Logged In User</span>
                        <small class="text-muted ms-2">Account ID: @conversation?.AccountId</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Conversation History -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Conversation History</h5>
        </div>
        <div class="card-body" style="max-height: 500px; overflow-y: auto;">
            @if (messages.Count == 0)
            {
                <p class="text-muted">No messages in this conversation.</p>
            }
            else
            {
                @foreach (var message in messages)
                {
                    <div class="mb-3 @(message.SenderType == "User" ? "text-start" : "text-end")">
                        <div class="d-inline-block" style="max-width: 70%;">
                            <div class="@(message.SenderType == "User" ? "bg-light" : message.SenderType == "Admin" ? "bg-success text-white" : "bg-primary text-white") p-3 rounded">
                                <div class="mb-1">
                                    <strong>
                                        @if (message.SenderType == "User")
                                        {
                                            <i class="bi bi-person-fill me-1"></i><span>User</span>
                                        }
                                        else if (message.SenderType == "Admin")
                                        {
                                            <i class="bi bi-shield-fill me-1"></i><span>Admin</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-robot me-1"></i><span>AI Assistant</span>
                                        }
                                    </strong>
                                </div>
                                <div>@message.MessageText</div>
                                <div class="mt-2">
                                    <small class="@(message.SenderType == "User" ? "text-muted" : "text-white-50")">
                                        @message.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Admin Response Form -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Send Response</h5>
        </div>
        <div class="card-body">
            <div id="responseAlert" class="alert d-none" role="alert"></div>
            
            <div class="mb-3">
                <label for="responseText" class="form-label">Your Response</label>
                <textarea 
                    id="responseText" 
                    class="form-control" 
                    rows="4" 
                    placeholder="Type your response to the user..."
                    maxlength="2000"></textarea>
                <div class="form-text">Maximum 2000 characters</div>
            </div>
            
            <button 
                id="sendResponseBtn" 
                class="btn btn-primary" 
                type="button">
                <i class="bi bi-send me-1"></i>Send Response
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const conversationId = @conversation?.Id;
            const sendBtn = document.getElementById('sendResponseBtn');
            const responseText = document.getElementById('responseText');
            const responseAlert = document.getElementById('responseAlert');
            const messagesContainer = document.querySelector('.card-body[style*="max-height"]');
            
            let lastCheckTime = new Date().toISOString();
            let pollingInterval = null;
            let notificationSound = null;

            // Initialize notification sound
            function initNotificationSound() {
                try {
                    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    notificationSound = function() {
                        const oscillator = audioContext.createOscillator();
                        const gainNode = audioContext.createGain();
                        
                        oscillator.connect(gainNode);
                        gainNode.connect(audioContext.destination);
                        
                        oscillator.frequency.value = 800;
                        oscillator.type = 'sine';
                        
                        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
                        
                        oscillator.start(audioContext.currentTime);
                        oscillator.stop(audioContext.currentTime + 0.5);
                    };
                } catch (e) {
                    console.log('Audio notification not available');
                }
            }

            // Poll for new messages
            async function pollNewMessages() {
                try {
                    const response = await fetch(`/AdminChat/PollNewMessages/${conversationId}?lastCheck=${encodeURIComponent(lastCheckTime)}`);
                    
                    if (!response.ok) {
                        console.error('Poll failed:', response.status);
                        return;
                    }

                    const data = await response.json();
                    
                    if (data.hasNew && data.messages.length > 0) {
                        console.log(`${data.messages.length} new message(s) detected`);
                        
                        // Play sound
                        if (notificationSound) {
                            notificationSound();
                        }
                        
                        // Add new messages to UI
                        data.messages.forEach(msg => {
                            addMessageToUI(msg);
                        });
                        
                        // Scroll to bottom
                        if (messagesContainer) {
                            messagesContainer.scrollTop = messagesContainer.scrollHeight;
                        }
                    }
                    
                    // Update last check time
                    lastCheckTime = data.serverTime;
                    
                } catch (error) {
                    console.error('Error polling messages:', error);
                }
            }

            // Add message to UI
            function addMessageToUI(message) {
                const messageDiv = document.createElement('div');
                messageDiv.className = `mb-3 ${message.senderType === 'User' ? 'text-start' : 'text-end'}`;
                
                const innerDiv = document.createElement('div');
                innerDiv.className = 'd-inline-block';
                innerDiv.style.maxWidth = '70%';
                
                const bubbleDiv = document.createElement('div');
                bubbleDiv.className = message.senderType === 'User' 
                    ? 'bg-light p-3 rounded' 
                    : message.senderType === 'Admin' 
                        ? 'bg-success text-white p-3 rounded' 
                        : 'bg-primary text-white p-3 rounded';
                
                const headerDiv = document.createElement('div');
                headerDiv.className = 'mb-1';
                const strong = document.createElement('strong');
                
                if (message.senderType === 'User') {
                    strong.innerHTML = '<i class="bi bi-person-fill me-1"></i>User';
                } else if (message.senderType === 'Admin') {
                    strong.innerHTML = '<i class="bi bi-shield-fill me-1"></i>Admin';
                } else {
                    strong.innerHTML = '<i class="bi bi-robot me-1"></i>AI Assistant';
                }
                
                headerDiv.appendChild(strong);
                
                const textDiv = document.createElement('div');
                textDiv.textContent = message.messageText;
                
                const timeDiv = document.createElement('div');
                timeDiv.className = 'mt-2';
                const timeSmall = document.createElement('small');
                timeSmall.className = message.senderType === 'User' ? 'text-muted' : 'text-white-50';
                timeSmall.textContent = new Date(message.createdAt).toLocaleString('vi-VN');
                timeDiv.appendChild(timeSmall);
                
                bubbleDiv.appendChild(headerDiv);
                bubbleDiv.appendChild(textDiv);
                bubbleDiv.appendChild(timeDiv);
                
                innerDiv.appendChild(bubbleDiv);
                messageDiv.appendChild(innerDiv);
                
                messagesContainer.appendChild(messageDiv);
            }

            // Start polling
            function startPolling() {
                pollNewMessages();
                pollingInterval = setInterval(pollNewMessages, 3000); // Poll every 3 seconds
                console.log('Message polling started: checking every 3 seconds');
            }

            // Stop polling
            function stopPolling() {
                if (pollingInterval) {
                    clearInterval(pollingInterval);
                    pollingInterval = null;
                    console.log('Message polling stopped');
                }
            }

            function showAlert(message, type) {
                responseAlert.className = `alert alert-${type}`;
                responseAlert.textContent = message;
                responseAlert.classList.remove('d-none');
                
                setTimeout(() => {
                    responseAlert.classList.add('d-none');
                }, 5000);
            }

            sendBtn.addEventListener('click', async function() {
                const text = responseText.value.trim();
                
                if (!text) {
                    showAlert('Please enter a response', 'warning');
                    return;
                }

                // Disable button during request
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sending...';

                try {
                    const response = await fetch('/AdminChat/Respond', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            conversationId: conversationId,
                            responseText: text
                        })
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        showAlert('Response sent successfully!', 'success');
                        responseText.value = '';
                        
                        // Reload page after 2 seconds to show the new message
                        setTimeout(() => {
                            window.location.reload();
                        }, 2000);
                    } else {
                        showAlert(result.message || 'Failed to send response', 'danger');
                    }
                } catch (error) {
                    console.error('Error sending response:', error);
                    showAlert('An error occurred while sending the response', 'danger');
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = '<i class="bi bi-send me-1"></i>Send Response';
                }
            });

            // Allow Enter key to send (with Shift+Enter for new line)
            responseText.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendBtn.click();
                }
            });

            // Initialize on page load
            document.addEventListener('DOMContentLoaded', function() {
                initNotificationSound();
                startPolling();
                
                // Add polling indicator
                const header = document.querySelector('.section-card h4');
                if (header) {
                    const indicator = document.createElement('span');
                    indicator.className = 'badge bg-success ms-2';
                    indicator.innerHTML = '<i class="bi bi-circle-fill" style="font-size: 8px;"></i> Live';
                    indicator.title = 'Auto-updating every 3 seconds';
                    header.appendChild(indicator);
                }
                
                // Scroll to bottom initially
                if (messagesContainer) {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }
            });

            // Stop polling when page is hidden
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    stopPolling();
                } else {
                    startPolling();
                }
            });

            // Stop polling before page unload
            window.addEventListener('beforeunload', function() {
                stopPolling();
            });
        })();
    </script>
}
