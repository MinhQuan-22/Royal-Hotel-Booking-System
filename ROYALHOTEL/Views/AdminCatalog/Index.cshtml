@{
    ViewData["Title"] = "MongoDB Catalog Sync";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header pb-0">
                    <h5>MongoDB Catalog Sync Management</h5>
                    <p class="text-sm mb-0">Quản lý đồng bộ dữ liệu từ SQL Server sang MongoDB HotelCatalog</p>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>Thành công!</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Lỗi!</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card bg-gradient-primary">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-white font-weight-bold">MongoDB Sync</p>
                                                <h5 class="font-weight-bolder text-white mb-0">
                                                    Full Sync
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-white shadow-primary text-center rounded-circle">
                                                <i class="ni ni-cloud-upload-96 text-lg opacity-10" aria-hidden="true"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <hr class="horizontal light my-3">
                                    <p class="text-sm mb-0 text-white">
                                        Đồng bộ toàn bộ hotels và rooms từ SQL Server sang MongoDB
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-gradient-info">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-8">
                                            <div class="numbers">
                                                <p class="text-sm mb-0 text-white font-weight-bold">Catalog Status</p>
                                                <h5 class="font-weight-bolder text-white mb-0">
                                                    Ready
                                                </h5>
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="icon icon-shape bg-white shadow-info text-center rounded-circle">
                                                <i class="ni ni-check-bold text-lg opacity-10" aria-hidden="true"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <hr class="horizontal light my-3">
                                    <p class="text-sm mb-0 text-white">
                                        MongoDB HotelCatalog đang hoạt động bình thường
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header pb-0">
                                    <h6>Sync Actions</h6>
                                </div>
                                <div class="card-body">
                                    <form asp-action="SyncAllToMongo" method="post" onsubmit="return confirm('Bạn có chắc muốn đồng bộ toàn bộ dữ liệu? Quá trình này có thể mất vài phút.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-sync-alt me-2"></i>
                                            Sync All Hotels to MongoDB
                                        </button>
                                    </form>

                                    <hr class="my-4">

                                    <div class="alert alert-info" role="alert">
                                        <strong>Lưu ý:</strong>
                                        <ul class="mb-0">
                                            <li>Sync tự động được thực hiện khi admin tạo hoặc chỉnh sửa room</li>
                                            <li>Sử dụng "Sync All" khi cần re-sync toàn bộ dữ liệu (ví dụ: sau khi restore MongoDB)</li>
                                            <li>Quá trình sync chạy trong background và không block UI</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
