@model ROYALHOTEL.ViewModels.AdminAmenityFormViewModel

@{
    ViewData["Title"] = "Edit Amenity";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-form-page">
    <div class="admin-toolbar">
        <div class="admin-toolbar__left">
            <h2 class="admin-section-title">Edit Amenity</h2>
            <p class="admin-section-subtitle">Update hotel amenity information.</p>
        </div>
    </div>

    <div class="admin-form-layout">
        <div class="admin-form-card admin-form-card--main">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div class="admin-form-grid">
                    <div class="admin-form-group">
                        <label asp-for="AmenityKey" class="form-label">Amenity Key</label>
                        <input asp-for="AmenityKey" class="form-control" />
                        <span asp-validation-for="AmenityKey" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="Name" class="form-label">Display Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="IconClass" class="form-label">Icon</label>
                        <input asp-for="IconClass" class="form-control" />
                        <span asp-validation-for="IconClass" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="Category" class="form-label">Category</label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </form>
        </div>

        <div class="admin-form-side">
            <div class="admin-preview-card">
                <div class="admin-preview-card__head">
                    <h3>Preview</h3>
                    <span>Current amenity</span>
                </div>

                <div class="admin-preview-card__body">
                    <h4>@Model.Name</h4>
                    <div class="admin-preview-meta">
                        <span class="admin-pill admin-pill--type">@Model.AmenityKey</span>
                        <span class="admin-pill admin-pill--guests">@(string.IsNullOrWhiteSpace(Model.Category) ? "No category" : Model.Category)</span>
                    </div>
                    <p>Icon: @(string.IsNullOrWhiteSpace(Model.IconClass) ? "-" : Model.IconClass)</p>
                    <span class="admin-status admin-status--confirmed">Ready</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}