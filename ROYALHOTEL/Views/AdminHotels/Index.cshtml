@using ROYALHOTEL.ViewModels
@model List<AdminHotelViewModel>

@{
    ViewData["Title"] = "Quản lý chi nhánh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-toolbar">
    <div class="admin-toolbar__left">
        <h2 class="admin-section-title">Quản lý Chi nhánh</h2>
        <p class="admin-section-subtitle">Thêm, sửa, xóa chi nhánh khách sạn Royal Luxury Hotel.</p>
    </div>
    <div class="admin-toolbar__right">
        <button class="btn btn-success admin-btn-add" onclick="openCreateModal()">
            + Thêm chi nhánh
        </button>
    </div>
</div>

<div class="admin-table-card">
    <div class="admin-table-card__head">
        <div>
            <h3>Danh sách chi nhánh</h3>
            <span id="hotelCountBadge">@Model.Count chi nhánh</span>
        </div>
    </div>

    <div class="admin-table-responsive">
        <table class="table admin-room-table align-middle" id="hotelsTable">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>Tên chi nhánh</th>
                    <th style="width:140px;">Thành phố</th>
                    <th>Địa chỉ</th>
                    <th style="width:100px;">Quốc gia</th>
                    <th style="width:130px;">Phòng ACTIVE</th>
                    <th style="width:180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="hotelsTableBody">
                @foreach (var h in Model)
                {
                    <tr id="hotel-row-@h.Id" data-hotel-id="@h.Id">
                        <td class="admin-room-id">#@h.Id</td>
                        <td>
                            <div class="admin-room-name">@h.Name</div>
                        </td>
                        <td>
                            <span class="admin-pill admin-pill--type">@h.City</span>
                        </td>
                        <td style="font-size:13px; color:#666;">@h.Address</td>
                        <td>@h.Country</td>
                        <td>
                            <span class="admin-pill admin-pill--guests">@h.ActiveRoomCount phòng</span>
                        </td>
                        <td>
                            <div class="admin-actions">
                                <button class="btn btn-sm admin-btn admin-btn-edit"
                                        onclick="openEditModal(@h.Id)">
                                    Sửa
                                </button>
                                <button class="btn btn-sm admin-btn admin-btn-delete"
                                        onclick="deleteHotel(@h.Id, '@h.Name.Replace("'", "\\'")')">
                                    Xóa
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="admin-empty-state" id="emptyState">
                <h4>Chưa có chi nhánh nào</h4>
                <p>Nhấn "Thêm chi nhánh" để bắt đầu.</p>
            </div>
        }
    </div>
</div>

<!-- ── MODAL: Tạo / Sửa chi nhánh ──────────────────────────────── -->
<div id="hotelModal" class="admin-modal-overlay" style="display:none;">
    <div class="admin-modal">
        <div class="admin-modal__head">
            <h3 id="modalTitle">Thêm chi nhánh</h3>
            <button class="admin-modal__close" onclick="closeModal()">✕</button>
        </div>
        <form id="hotelForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="hotelId" name="Id" value="0" />

            <div class="admin-form-grid" style="gap:16px; padding:24px;">
                <div class="admin-form-group">
                    <label class="form-label">Tên chi nhánh <span style="color:red">*</span></label>
                    <input type="text" id="hotelName" class="form-control" placeholder="Royal Luxury Da Nang" required />
                    <span class="text-danger" id="errName"></span>
                </div>

                <div class="admin-form-group">
                    <label class="form-label">Thành phố <span style="color:red">*</span></label>
                    <input type="text" id="hotelCity" class="form-control" placeholder="Da Nang" required />
                    <span class="text-danger" id="errCity"></span>
                </div>

                <div class="admin-form-group admin-form-group--full">
                    <label class="form-label">Địa chỉ <span style="color:red">*</span></label>
                    <input type="text" id="hotelAddress" class="form-control" placeholder="Đường Mỹ Khê, Đà Nẵng" required />
                    <span class="text-danger" id="errAddress"></span>
                </div>

                <div class="admin-form-group">
                    <label class="form-label">Quốc gia</label>
                    <input type="text" id="hotelCountry" class="form-control" value="Vietnam" />
                </div>
            </div>

            <div class="admin-form-actions" style="padding:0 24px 24px; gap:12px;">
                <button type="button" class="btn btn-primary" id="saveBtn" onclick="saveHotel()">Lưu</button>
                <button type="button" class="btn btn-outline-secondary" onclick="closeModal()">Hủy</button>
            </div>

            <div id="formError" class="alert alert-danger mx-4 mb-4" style="display:none;"></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

// ── Mở modal TẠO ───────────────────────────────────────────────
function openCreateModal() {
    document.getElementById('modalTitle').textContent = 'Thêm chi nhánh';
    document.getElementById('hotelId').value = '0';
    document.getElementById('hotelName').value = '';
    document.getElementById('hotelCity').value = '';
    document.getElementById('hotelAddress').value = '';
    document.getElementById('hotelCountry').value = 'Vietnam';
    clearErrors();
    document.getElementById('hotelModal').style.display = 'flex';
    document.getElementById('hotelName').focus();
}

// ── Mở modal SỬA ───────────────────────────────────────────────
async function openEditModal(id) {
    try {
        const res = await fetch(`/AdminHotels/GetHotel?id=${id}`);
        const data = await res.json();
        if (!data.success) { showToast('error', data.message); return; }

        document.getElementById('modalTitle').textContent = 'Sửa chi nhánh';
        document.getElementById('hotelId').value = data.hotel.id;
        document.getElementById('hotelName').value = data.hotel.name;
        document.getElementById('hotelCity').value = data.hotel.city;
        document.getElementById('hotelAddress').value = data.hotel.address;
        document.getElementById('hotelCountry').value = data.hotel.country;
        clearErrors();
        document.getElementById('hotelModal').style.display = 'flex';
        document.getElementById('hotelName').focus();
    } catch (e) {
        showToast('error', 'Không thể tải dữ liệu chi nhánh.');
    }
}

// ── Đóng modal ─────────────────────────────────────────────────
function closeModal() {
    document.getElementById('hotelModal').style.display = 'none';
}
document.getElementById('hotelModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});

// ── Lưu (Tạo hoặc Sửa) ────────────────────────────────────────
async function saveHotel() {
    clearErrors();
    const id = parseInt(document.getElementById('hotelId').value);
    const payload = {
        Id: id,
        Name: document.getElementById('hotelName').value.trim(),
        City: document.getElementById('hotelCity').value.trim(),
        Address: document.getElementById('hotelAddress').value.trim(),
        Country: document.getElementById('hotelCountry').value.trim() || 'Vietnam'
    };

    const isCreate = id === 0;
    const url = isCreate ? '/AdminHotels/Create' : '/AdminHotels/Edit';

    document.getElementById('saveBtn').disabled = true;
    document.getElementById('saveBtn').textContent = 'Đang lưu...';

    try {
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
            const msg = data.message || (data.errors ? data.errors.join('<br>') : 'Có lỗi xảy ra.');
            document.getElementById('formError').innerHTML = msg;
            document.getElementById('formError').style.display = 'block';
            return;
        }

        closeModal();
        showToast('success', data.message);

        if (isCreate) {
            appendHotelRow(data.hotel);
        } else {
            updateHotelRow(data.hotel);
        }
        updateCount();

    } catch (e) {
        document.getElementById('formError').textContent = 'Lỗi kết nối. Vui lòng thử lại.';
        document.getElementById('formError').style.display = 'block';
    } finally {
        document.getElementById('saveBtn').disabled = false;
        document.getElementById('saveBtn').textContent = 'Lưu';
    }
}

// ── Xóa chi nhánh ─────────────────────────────────────────────
async function deleteHotel(id, name) {
    const result = await Swal.fire({
        title: 'Xác nhận xóa',
        text: `Bạn có chắc muốn xóa chi nhánh "${name}"? Hành động này không thể hoàn tác.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Xóa',
        cancelButtonText: 'Hủy'
    });

    if (!result.isConfirmed) return;

    try {
        const res = await fetch('/AdminHotels/Delete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify(id)
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
            await Swal.fire({ icon: 'error', title: 'Không thể xóa', text: data.message });
            return;
        }

        showToast('success', data.message);
        const row = document.getElementById(`hotel-row-${id}`);
        if (row) {
            row.style.transition = 'opacity 0.4s ease';
            row.style.opacity = '0';
            setTimeout(() => { row.remove(); updateCount(); }, 420);
        }

    } catch (e) {
        showToast('error', 'Lỗi kết nối. Vui lòng thử lại.');
    }
}

// ── Thêm row mới vào bảng ──────────────────────────────────────
function appendHotelRow(h) {
    const tbody = document.getElementById('hotelsTableBody');
    const row = document.createElement('tr');
    row.id = `hotel-row-${h.id}`;
    row.dataset.hotelId = h.id;
    row.style.opacity = '0';
    row.innerHTML = buildRowHTML(h);
    tbody.appendChild(row);
    document.getElementById('emptyState')?.remove();
    requestAnimationFrame(() => {
        row.style.transition = 'opacity 0.4s ease';
        row.style.opacity = '1';
    });
}

// ── Cập nhật row hiện có ───────────────────────────────────────
function updateHotelRow(h) {
    const row = document.getElementById(`hotel-row-${h.id}`);
    if (!row) return;
    // Giữ lại cột phòng đang hiện
    const roomBadge = row.querySelector('.admin-pill--guests')?.textContent || '0 phòng';
    row.innerHTML = buildRowHTML({ ...h, roomBadgeText: roomBadge });
    row.style.transition = 'background 0.4s ease';
    row.style.background = 'rgba(201,162,74,0.08)';
    setTimeout(() => { row.style.background = ''; }, 1200);
}

function buildRowHTML(h) {
    const rooms = h.roomBadgeText ?? `${h.activeRoomCount ?? 0} phòng`;
    const safeName = (h.name || '').replace(/'/g, "\\'");
    return `
        <td class="admin-room-id">#${h.id}</td>
        <td><div class="admin-room-name">${h.name}</div></td>
        <td><span class="admin-pill admin-pill--type">${h.city}</span></td>
        <td style="font-size:13px;color:#666;">${h.address}</td>
        <td>${h.country}</td>
        <td><span class="admin-pill admin-pill--guests">${rooms}</span></td>
        <td>
            <div class="admin-actions">
                <button class="btn btn-sm admin-btn admin-btn-edit" onclick="openEditModal(${h.id})">Sửa</button>
                <button class="btn btn-sm admin-btn admin-btn-delete" onclick="deleteHotel(${h.id}, '${safeName}')">Xóa</button>
            </div>
        </td>`;
}

function updateCount() {
    const count = document.querySelectorAll('#hotelsTableBody tr[id^="hotel-row-"]').length;
    document.getElementById('hotelCountBadge').textContent = `${count} chi nhánh`;
}

function clearErrors() {
    document.getElementById('errName').textContent = '';
    document.getElementById('errCity').textContent = '';
    document.getElementById('errAddress').textContent = '';
    document.getElementById('formError').style.display = 'none';
    document.getElementById('formError').innerHTML = '';
}

function showToast(icon, title) {
    Swal.mixin({
        toast: true, position: 'top-end',
        showConfirmButton: false, timer: 3000, timerProgressBar: true
    }).fire({ icon, title });
}

// Enter key để lưu
document.getElementById('hotelForm').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') saveHotel();
});
</script>
}

@section Styles {
<style>
.admin-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    backdrop-filter: blur(2px);
}
.admin-modal {
    background: #fff;
    border-radius: 8px;
    width: min(560px, calc(100vw - 32px));
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    animation: modalIn 0.25s ease;
}
@@keyframes modalIn {
    from { opacity: 0; transform: scale(0.95) translateY(-10px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}
.admin-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px;
    border-bottom: 1px solid #f0e8d5;
}
.admin-modal__head h3 {
    margin: 0;
    font-size: 18px;
    color: #2b2b2b;
    font-family: "Playfair Display", Georgia, serif;
}
.admin-modal__close {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #999;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 4px;
    transition: all 0.2s;
}
.admin-modal__close:hover {
    background: #f5f5f5;
    color: #333;
}
</style>
}
