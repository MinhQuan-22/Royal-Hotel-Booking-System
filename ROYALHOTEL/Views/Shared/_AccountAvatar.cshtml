@using Microsoft.AspNetCore.Http
@using ROYALHOTEL.Services.Accounts

@{
    var _reg = AuthSessionRegistry.Instance;
    var email = Context.Session.GetString(_reg.UserEmailKey);
    var name = Context.Session.GetString(_reg.UserNameKey) ?? "";
    var role = Context.Session.GetString(_reg.UserRoleKey) ?? "";
    var isLoggedIn = !string.IsNullOrWhiteSpace(email);
    var isAdmin = role.ToLower() == "admin";
}

<div class="rh-account">
@if (isLoggedIn)
{
    <button class="rh-account__btn" type="button" data-dropdown="account">
        <span class="rh-account__icon">👤</span>
        <span class="rh-account__text">Chào mừng,<br /><b>@name</b></span>
        <span class="rh-account__caret">▾</span>
    </button>

    <div class="rh-account__menu" data-dropdown-menu="account">
        @if (isAdmin)
        {
            <a class="rh-account__item" asp-controller="Admin" asp-action="Index">Admin Management</a>
        }

        <a class="rh-account__item" asp-controller="Booking" asp-action="MyBookings">Lịch sử đặt phòng</a>
        <a class="rh-account__item" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
    </div>
}
else
{
    <a class="rh-account__btn" asp-controller="Account" asp-action="Login" style="text-decoration:none;">
        <span class="rh-account__icon">👤</span>
        <span class="rh-account__text">Đăng nhập</span>
    </a>
}
</div>