
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ROYALHOTEL</title>

    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="/css/chat-widget.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] as string ?? "")">
    @RenderBody()

    <partial name="_Footer" />

    @if (ViewData["HideScrollTop"] as bool? != true)
    {
        <button id="rhScrollTopBtn" class="rh-scrollTop" type="button" aria-label="Lên đầu trang">
            <span class="rh-scrollTop__icon">↑</span>
        </button>
    }

    @* Chat Widget *@
    <partial name="_ChatWidget" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chat-widget.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
