@model ROYALHOTEL.ViewModels.AdminReportViewModel
@{
    ViewData["Title"] = "Báo cáo phân tích chuyên sâu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    string fmtM(decimal v) => v >= 1_000_000_000 ? $"{v/1_000_000_000:F2}B ₫"
        : v >= 1_000_000 ? $"{v/1_000_000:F1}M ₫" : $"{v:N0} ₫";
        
    var years = new[]{2024,2025,2026};
    var months = new (int v,string l)[]{(0,"Tất cả tháng"),(1,"Tháng 1"),(2,"Tháng 2"),
        (3,"Tháng 3"),(4,"Tháng 4"),(5,"Tháng 5"),(6,"Tháng 6"),
        (7,"Tháng 7"),(8,"Tháng 8"),(9,"Tháng 9"),(10,"Tháng 10"),(11,"Tháng 11"),(12,"Tháng 12")};
        
    string periodLabel = Model.SelectedMonth == 0 ? $"Cả năm {Model.SelectedYear}"
        : $"Tháng {Model.SelectedMonth}/{Model.SelectedYear}";
    string branchLabel = Model.SelectedHotelId > 0 
        ? Model.Hotels.FirstOrDefault(h => h.Id == Model.SelectedHotelId).Name ?? "Chi nhánh"
        : "Tất cả chi nhánh";

    // Tính toán số liệu phụ
    int totalBranches = Model.RoomPerformance.Select(x => x.Branch).Distinct().Count();
    int totalRooms = Model.RoomPerformance.Count;
    int totalBookings = Model.RoomPerformance.Sum(x => x.TotalBookings);

    // Phân nhóm
    var highPerf = Model.RoomPerformance.Where(x => x.OccupancyPct >= 70 && x.CancellationPct < 10).ToList();
    var stablePerf = Model.RoomPerformance.Where(x => x.OccupancyPct >= 50 && x.OccupancyPct < 70 && x.CancellationPct < 12).ToList();
    var needImprove = Model.RoomPerformance.Where(x => x.OccupancyPct < 50).ToList();
    var highRisk = Model.RoomPerformance.Where(x => x.CancellationPct >= 10).ToList();
}

@section Styles {
<style>
/* ── Base ── */
.rep-page{font-family:'Inter','Segoe UI',system-ui,sans-serif; color: #333; background-color: #fcfbfa; padding: 10px;}
.rep-sec{font-size:16px;font-weight:800;color:#111;text-transform:uppercase;letter-spacing:.5px;margin:40px 0 20px;display:flex;align-items:center;gap:10px;border-bottom: 2px solid #d9caa7;padding-bottom: 12px;}
.rep-sec i {color: #8b6a14; font-size: 20px;}

/* ── Filter ── */
.rep-filter{background:#fff;border:1px solid #eadfcb;border-radius:12px;padding:20px 24px;margin-bottom:30px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);}
.rep-filter-row{display:flex;align-items:flex-end;gap:20px;flex-wrap:nowrap}
.rep-fg{display:flex;flex-direction:column;flex:1}
.rep-lbl{font-size:12px;font-weight:700;text-transform:uppercase;color:#888;margin-bottom:8px}
.rep-filter .form-select{border-color:#d9caa7;font-size:14px;border-radius:8px; padding: 10px 15px;}
.rep-btn{background:linear-gradient(135deg, #8b6a14, #c9a24a);color:#fff;border:none;border-radius:8px;padding:10px 28px;font-weight:700;font-size:14px; box-shadow: 0 4px 10px rgba(139,106,20,0.2); transition: 0.2s;}
.rep-btn:hover{transform: translateY(-2px); box-shadow: 0 6px 15px rgba(139,106,20,0.3); color:#fff;}

/* ── Info Block ── */
.info-block { background: #fff; border: 1px solid #eadfcb; border-radius: 12px; padding: 24px; font-size: 15px; line-height: 1.8; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
.info-block ul { margin: 0; padding-left: 20px; color: #555;}
.info-block li { margin-bottom: 8px; }
.info-highlight { font-weight: 700; color: #8b6a14; background: #fffdf7; padding: 2px 6px; border-radius: 4px;}

/* ── Performance Groups ── */
.pg-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
.pg-card { background: #fff; border: 1px solid #eadfcb; border-radius: 12px; padding: 20px; border-top: 5px solid #ccc; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: 0.2s;}
.pg-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.06); }
.pg-card.high { border-top-color: #2e7d32; }
.pg-card.stable { border-top-color: #1565c0; }
.pg-card.improve { border-top-color: #f57c00; }
.pg-card.risk { border-top-color: #c62828; }
.pg-title { font-weight: 800; font-size: 16px; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;}
.pg-count { font-size: 28px; font-weight: 900; margin-bottom: 16px; color: #111;}
.pg-list { font-size: 13px; color: #666; margin: 0; padding-left: 18px; line-height: 1.6;}

/* ── Insights Block ── */
.insight-block { background: #fff; border: 1px solid #eadfcb; border-left: 5px solid #8b6a14; padding: 24px; border-radius: 12px; font-size: 15px; line-height: 1.8; box-shadow: 0 4px 15px rgba(0,0,0,0.03); color: #555;}

/* ── Tables ── */
.data-table-wrap { background: #fff; border: 1px solid #eadfcb; border-radius: 12px; overflow: hidden; margin-bottom: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
.data-table { width: 100%; border-collapse: collapse; font-size: 14px; text-align: left; }
.data-table th { background: linear-gradient(135deg, #fdfbf7, #f7f2e8); color: #8b6a14; padding: 16px 20px; font-weight: 800; border-bottom: 2px solid #eadfcb; white-space: nowrap; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px;}
.data-table td { padding: 16px 20px; border-bottom: 1px solid #f5f0e4; vertical-align: middle; color: #444;}
.data-table tbody tr:hover { background: #fffdf7; }
.data-table .num { font-variant-numeric: tabular-nums; font-weight: 700; text-align: right; }
.data-table th.num { text-align: right; }

.badge-branch { padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; background: #f0f0f0; color: #555;}
.badge-act { padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 800; letter-spacing: 0.3px;}
.act-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9;}
.act-warning { background: #fff3e0; color: #e65100; border: 1px solid #ffe0b2;}
.act-danger { background: #ffebee; color: #c62828; border: 1px solid #ffcdd2;}
.act-info { background: #e3f2fd; color: #1565c0; border: 1px solid #bbdefb;}

.sql-note { font-family: monospace; font-size: 12px; color: #666; background: #f9f9f9; padding: 10px; border-radius: 4px; margin-top: 10px; border: 1px dashed #ccc; display: inline-block; }
</style>
}

<div class="rep-page">

<!-- FILTER -->
<form method="get" action="@Url.Action("Index","AdminReports")" class="rep-filter">
    <div class="rep-filter-row">
        <div class="rep-fg">
            <div class="rep-lbl">Chi nhánh</div>
            <select name="hotelId" class="form-select">
                <option value="0" selected="@(Model.SelectedHotelId == 0)">Tất cả chi nhánh</option>
                @foreach (var h in Model.Hotels) {
                    if (Model.SelectedHotelId == h.Id) { <option value="@h.Id" selected>@h.Name</option> }
                    else { <option value="@h.Id">@h.Name</option> }
                }
            </select>
        </div>
        <div class="rep-fg">
            <div class="rep-lbl">Năm</div>
            <select name="year" class="form-select">
                @foreach (var y in years) {
                    if (Model.SelectedYear==y) { <option value="@y" selected>@y</option> }
                    else { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <div class="rep-fg">
            <div class="rep-lbl">Tháng</div>
            <select name="month" class="form-select">
                @foreach (var (v,l) in months) {
                    if (Model.SelectedMonth==v) { <option value="@v" selected>@l</option> }
                    else { <option value="@v">@l</option> }
                }
            </select>
        </div>
        <button type="submit" class="rep-btn">Cập nhật Báo Cáo</button>
    </div>
</form>

<!-- THÔNG TIN KỲ BÁO CÁO -->
<div class="rep-sec">1. Thông tin kỳ báo cáo</div>
<div class="info-block">
    <ul>
        <li><strong>Kỳ báo cáo:</strong> <span class="info-highlight">@periodLabel</span></li>
        <li><strong>Phạm vi phân tích:</strong> @branchLabel</li>
        <li><strong>Quy mô dữ liệu:</strong> @totalBranches chi nhánh | @totalRooms hạng phòng | @totalBookings lượt booking hợp lệ.</li>
        <li><strong>Công thức kế toán:</strong> <code>Doanh thu thực tế (Net) = Doanh thu gộp (Gross) - Tiền hoàn (Refund)</code>.</li>
        <li><strong>Ghi chú hệ thống:</strong> Chỉ tổng hợp dữ liệu từ các booking có trạng thái không phải <i>Pending</i>. Booking <i>Cancelled</i> vẫn được tính vào doanh thu nếu có phát sinh phí phạt theo quy định.</li>
    </ul>
</div>

<!-- PHÂN NHÓM HIỆU SUẤT -->
<div class="rep-sec">2. Phân nhóm hiệu suất phòng</div>
<div class="pg-grid">
    <div class="pg-card high">
        <div class="pg-title" style="color:#2e7d32">Hiệu suất cao</div>
        <div class="pg-count">@highPerf.Count phòng</div>
        <ul class="pg-list">
            @foreach(var r in highPerf.Take(3)) { <li>@r.RoomCode (@r.OccupancyPct.ToString("F0")%)</li> }
        </ul>
        <div style="font-size:11px; margin-top:10px; color:#aaa">Lấp phòng >70%, Hủy <10%</div>
    </div>
    <div class="pg-card stable">
        <div class="pg-title" style="color:#1565c0">Ổn định</div>
        <div class="pg-count">@stablePerf.Count phòng</div>
        <ul class="pg-list">
            @foreach(var r in stablePerf.Take(3)) { <li>@r.RoomCode (@r.OccupancyPct.ToString("F0")%)</li> }
        </ul>
        <div style="font-size:11px; margin-top:10px; color:#aaa">Lấp phòng 50-70%</div>
    </div>
    <div class="pg-card improve">
        <div class="pg-title" style="color:#f57c00">Cần cải thiện</div>
        <div class="pg-count">@needImprove.Count phòng</div>
        <ul class="pg-list">
            @foreach(var r in needImprove.Take(3)) { <li>@r.RoomCode (@r.OccupancyPct.ToString("F0")%)</li> }
        </ul>
        <div style="font-size:11px; margin-top:10px; color:#aaa">Lấp phòng <50%</div>
    </div>
    <div class="pg-card risk">
        <div class="pg-title" style="color:#c62828">Rủi ro hủy cao</div>
        <div class="pg-count">@highRisk.Count phòng</div>
        <ul class="pg-list">
            @foreach(var r in highRisk.Take(3)) { <li>@r.RoomCode (Hủy @r.CancellationPct.ToString("F0")%)</li> }
        </ul>
        <div style="font-size:11px; margin-top:10px; color:#aaa">Tỷ lệ hủy >10%</div>
    </div>
</div>

<!-- XẾP HẠNG WINDOW FUNCTION -->
<div class="rep-sec">3. Xếp hạng phòng theo Doanh thu thực tế</div>
<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Hạng</th>
                <th>Kỳ báo cáo</th>
                <th>Chi nhánh</th>
                <th>Mã phòng</th>
                <th>Tên phòng</th>
                <th class="num">Doanh thu thực tế</th>
                <th class="num">Lấp phòng</th>
                <th class="num">% Đóng góp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.TopRooms) {
                <tr>
                    <td><strong>#@r.Rank</strong></td>
                    <td>@periodLabel</td>
                    <td><span class="badge-branch">@r.Branch</span></td>
                    <td>@r.RoomCode</td>
                    <td>@r.RoomName</td>
                    <td class="num" style="color:#8b6a14">@fmtM(r.NetRevenue)</td>
                    <td class="num">@r.OccupancyPct.ToString("F1")%</td>
                    <td class="num">@r.ContributionPct.ToString("F1")%</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- INSIGHTS THỜI GIAN -->
<div class="rep-sec" style="margin-top:40px;">4. Phân tích chu kỳ thời gian</div>
<div class="insight-block">
    <div style="margin-bottom:8px"><strong>Phân tích biến động:</strong> Chu kỳ có doanh thu cao nhất là <span class="info-highlight">@Model.HighestRevenueMonth</span>, trong khi <span class="info-highlight">@Model.LowestRevenueMonth</span> ghi nhận mức thấp kỷ lục. 
    Chu kỳ có lưu lượng khách đông đúc nhất (lượng booking cao nhất) là <strong>@Model.MostBookingMonth</strong> với @Model.MostBookingCount lượt đặt.</div>
    
    <div style="margin-top:15px; padding-top:15px; border-top:1px dashed #d9caa7"><strong>Định hướng chiến lược giá (Dynamic Pricing):</strong>
    <br>- Hệ thống liên tục theo dõi công suất lấp phòng (Occupancy) và tỷ lệ hủy (Cancellation Rate) để đưa ra đề xuất tăng giảm giá động ở mục <strong>Action Plan</strong> bên dưới.
    <br>- Các khuyến nghị này được sinh ra hoàn toàn tự động dựa trên số liệu thực tế của từng phòng thay vì áp dụng máy móc theo mùa vụ.</div>
</div>

<!-- ACTION PLAN TABLE -->
<div class="rep-sec">5. Kế hoạch hành động đề xuất (Action Plan)</div>
<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mức Ưu Tiên</th>
                <th>Mục Tiêu (Phòng)</th>
                <th>Tình trạng dữ liệu</th>
                <th>Hành động đề xuất</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rec in Model.PricingRecs.OrderBy(x => x.Level == "danger" ? 1 : x.Level == "warning" ? 2 : 3)) {
                string pty = rec.Level == "danger" ? "CAO" : rec.Level == "warning" ? "TRUNG BÌNH" : "QUAN SÁT";
                <tr>
                    <td><span class="badge-act act-@rec.Level">@pty</span></td>
                    <td><strong>@rec.RoomCode</strong><br><span style="font-size:11px;color:#888">@rec.Branch</span></td>
                    <td>Lấp phòng: <strong>@rec.OccupancyPct.ToString("F1")%</strong> | Hủy: <strong>@rec.CancellationPct.ToString("F1")%</strong></td>
                    <td>@rec.Recommendation</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- DETAILED PERFORMANCE TABLE -->
<div class="rep-sec">6. Bảng dữ liệu hiệu suất chi tiết</div>
<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Chi nhánh</th>
                <th>Mã phòng</th>
                <th>Loại phòng</th>
                <th class="num">Doanh thu Gộp</th>
                <th class="num">Tiền hoàn</th>
                <th class="num">Doanh thu TT</th>
                <th class="num">Lượt Đặt</th>
                <th class="num">Lấp phòng</th>
                <th class="num">Tỷ lệ hủy</th>
                <th>Đánh giá hệ thống</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.RoomPerformance.OrderByDescending(x => x.NetRevenue)) {
                <tr>
                    <td><span class="badge-branch">@r.Branch</span></td>
                    <td><strong>@r.RoomCode</strong></td>
                    <td>@r.RoomType</td>
                    <td class="num">@fmtM(r.GrossRevenue)</td>
                    <td class="num" style="color:#c62828">@fmtM(r.RefundAmount)</td>
                    <td class="num" style="color:#2e7d32; font-weight:700">@fmtM(r.NetRevenue)</td>
                    <td class="num">@r.TotalBookings</td>
                    <td class="num">@r.OccupancyPct.ToString("F1")%</td>
                    <td class="num">@r.CancellationPct.ToString("F1")%</td>
                    <td><span class="badge-act act-@r.ActionLevel">@r.SuggestedAction</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

</div>
