@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["HideScrollTop"] = true;
    ViewData["BodyClass"] = "body--auth";
    var show = (bool?)(ViewBag.ShowOtpModal) == true;
    var email = (string?)ViewBag.Email ?? "";
    var requestId = (string?)ViewBag.RequestId ?? "";
    var expiresIso = (string?)ViewBag.ExpiresAtIso ?? "";
}

@await Html.PartialAsync("_AuthNav")

<section class="rh-loginPage">
  <div class="rh-loginPage__overlay"></div>

  <div class="rh-container">
    <div class="rh-loginBox">
      <div class="rh-loginBox__brand">
        <div class="rh-loginBox__brandTop">ROYAL</div>
        <div class="rh-loginBox__brandBot">LUXURY HOTEL</div>
      </div>

      <div class="rh-loginBox__header">
        <h1 class="rh-loginBox__title">Quên mật khẩu</h1>
        <p class="rh-loginBox__subtitle">Nhập email để nhận OTP đặt lại mật khẩu</p>
      </div>

      @if (ViewBag.ErrorMessage != null)
      {
        <div class="rh-loginBox__error">
          <span class="rh-loginBox__errorIcon">⚠</span>
          @ViewBag.ErrorMessage
        </div>
      }
      @if (ViewBag.InfoMessage != null)
      {
        <div class="rh-loginBox__error" style="background:#eef7ff;border-color:#cfe7ff;color:#1a4b7a;">
          @ViewBag.InfoMessage
        </div>
      }

      <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="rh-loginForm">
        @Html.AntiForgeryToken()
        <div class="rh-loginForm__group">
          <label class="rh-loginForm__label">Email</label>
          <div class="rh-loginForm__inputWrapper">
            <span class="rh-loginForm__icon">✉</span>
            <input type="email" name="email" class="rh-loginForm__input" placeholder="example@email.com" required value="@email" />
          </div>
        </div>

        <button type="submit" class="rh-loginForm__submit">
          <span>Gửi OTP</span>
          <span class="rh-loginForm__submitIcon">→</span>
        </button>

        <div class="rh-loginForm__register" style="margin-top:14px;">
          Quay lại <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </div>
      </form>
    </div>
  </div>
</section>

@if (show)
{
  <!-- OTP MODAL -->
  <div class="rh-otpOverlay" id="otpOverlay">
    <div class="rh-otpModal" role="dialog" aria-modal="true">
      <div class="rh-otpModal__title">Nhập OTP</div>
      <div class="rh-otpModal__sub">
        OTP đã gửi tới <b>@email</b> • Hết hạn sau <b id="otpTimer">03:00</b>
      </div>

      <form method="post" asp-controller="Account" asp-action="ResetPassword" class="rh-loginForm" style="margin-top:14px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="requestId" value="@requestId" />
        <input type="hidden" name="email" value="@email" />
        <input type="hidden" id="expiresIso" value="@expiresIso" />

        <div class="rh-loginForm__group">
          <label class="rh-loginForm__label">OTP (6 số)</label>
          <input type="text" name="otp" class="rh-loginForm__input" inputmode="numeric" maxlength="6" placeholder="000000" required />
        </div>

        <div class="rh-loginForm__group">
            <label class="rh-loginForm__label">Mật khẩu mới</label>
            <div class="rh-loginForm__inputWrapper rh-loginForm__inputWrapper--password">
                <span class="rh-loginForm__icon">🔒</span>
                <input type="password"
                      id="forgotNewPassword"
                      name="newPassword"
                      class="rh-loginForm__input rh-loginForm__input--password"
                      placeholder="••••••••"
                      required />

                <button type="button"
                        class="rh-loginForm__passwordToggle"
                        data-password-toggle
                        data-toggle-target="forgotNewPassword"
                        aria-label="Giữ để xem mật khẩu"
                        aria-pressed="false">
                    <svg class="rh-loginForm__passwordIcon"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true">
                        <path d="M2 12C3.8 8.8 7.2 6.5 12 6.5C16.8 6.5 20.2 8.8 22 12C20.2 15.2 16.8 17.5 12 17.5C7.2 17.5 3.8 15.2 2 12Z"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <circle cx="12" cy="12" r="3"
                                stroke="currentColor"
                                stroke-width="1.8" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="rh-loginForm__group">
            <label class="rh-loginForm__label">Xác nhận mật khẩu</label>
            <div class="rh-loginForm__inputWrapper rh-loginForm__inputWrapper--password">
                <span class="rh-loginForm__icon">🔒</span>
                <input type="password"
                      id="forgotConfirmPassword"
                      name="confirmPassword"
                      class="rh-loginForm__input rh-loginForm__input--password"
                      placeholder="••••••••"
                      required />

                <button type="button"
                        class="rh-loginForm__passwordToggle"
                        data-password-toggle
                        data-toggle-target="forgotConfirmPassword"
                        aria-label="Giữ để xem mật khẩu"
                        aria-pressed="false">
                    <svg class="rh-loginForm__passwordIcon"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true">
                        <path d="M2 12C3.8 8.8 7.2 6.5 12 6.5C16.8 6.5 20.2 8.8 22 12C20.2 15.2 16.8 17.5 12 17.5C7.2 17.5 3.8 15.2 2 12Z"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round" />
                        <circle cx="12" cy="12" r="3"
                                stroke="currentColor"
                                stroke-width="1.8" />
                    </svg>
                </button>
            </div>
        </div>

        <button type="submit" class="rh-loginForm__submit" id="otpSubmitBtn">
          <span>Đặt lại mật khẩu</span>
          <span class="rh-loginForm__submitIcon">→</span>
        </button>
      </form>
    </div>
  </div>

  <script>
    (function(){
      const iso = document.getElementById('expiresIso')?.value;
      const timerEl = document.getElementById('otpTimer');
      const btn = document.getElementById('otpSubmitBtn');
      if(!iso || !timerEl) return;

      const expires = new Date(iso).getTime();
      const tick = () => {
        const now = Date.now();
        let left = Math.max(0, expires - now);

        const mm = String(Math.floor(left / 60000)).padStart(2,'0');
        const ss = String(Math.floor((left % 60000) / 1000)).padStart(2,'0');
        timerEl.textContent = mm + ":" + ss;

        if(left <= 0){
          if(btn) btn.disabled = true;
          timerEl.textContent = "00:00";
        }
      };

      tick();
      setInterval(tick, 1000);
    })();
  </script>
}

<style>
/* OTP popup overlay (mờ nền) */
.rh-otpOverlay{
  position:fixed; inset:0;
  background:rgba(0,0,0,.55);
  display:flex; align-items:center; justify-content:center;
  z-index:9999;
}
.rh-otpModal{
  width:min(520px, calc(100% - 32px));
  background:#fff;
  border-radius:12px;
  padding:20px;
  box-shadow:0 18px 60px rgba(0,0,0,.25);
}
.rh-otpModal__title{
  font-size:22px;
  font-weight:700;
  color:#1b1b1b;
  margin-bottom:6px;
}
.rh-otpModal__sub{
  color:#666;
  font-size:14px;
}
</style>
