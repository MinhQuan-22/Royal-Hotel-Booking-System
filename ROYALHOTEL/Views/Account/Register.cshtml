@{
    ViewData["Title"] = "Đăng ký";
    ViewData["HideScrollTop"] = true;
    ViewData["BodyClass"] = "body--auth";
}

@await Html.PartialAsync("_AuthNav")

<!-- REGISTER PAGE -->
<section class="rh-loginPage">
    <div class="rh-container">
        
        <div class="rh-loginBox">
            <div class="rh-loginBox__header">
                <h1 class="rh-loginBox__title">Đăng ký tài khoản</h1>
                <p class="rh-loginBox__subtitle">Tạo tài khoản để trải nghiệm dịch vụ tốt nhất</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="rh-loginBox__error">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Register" class="rh-loginForm">
                @Html.AntiForgeryToken()
                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Họ và tên</label>
                    <input type="text" name="fullName" class="rh-loginForm__input" placeholder="Nguyễn Văn A" required />
                </div>

                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Email</label>
                    <input type="email" name="email" class="rh-loginForm__input" placeholder="example@email.com" required />
                </div>

                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Số điện thoại</label>
                    <input type="tel" name="phone" class="rh-loginForm__input" placeholder="0123456789" required />
                </div>

                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Mật khẩu</label>
                    <div class="rh-loginForm__inputWrapper rh-loginForm__inputWrapper--password">
                        <span class="rh-loginForm__icon">🔒</span>
                        <input type="password"
                            id="registerPassword"
                            name="password"
                            class="rh-loginForm__input rh-loginForm__input--password"
                            placeholder="••••••••"
                            required />

                        <button type="button"
                                class="rh-loginForm__passwordToggle"
                                data-password-toggle
                                data-toggle-target="registerPassword"
                                aria-label="Giữ để xem mật khẩu"
                                aria-pressed="false">
                            <svg class="rh-loginForm__passwordIcon"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                aria-hidden="true">
                                <path d="M2 12C3.8 8.8 7.2 6.5 12 6.5C16.8 6.5 20.2 8.8 22 12C20.2 15.2 16.8 17.5 12 17.5C7.2 17.5 3.8 15.2 2 12Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round" />
                                <circle cx="12" cy="12" r="3"
                                        stroke="currentColor"
                                        stroke-width="1.8" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Xác nhận mật khẩu</label>
                    <div class="rh-loginForm__inputWrapper rh-loginForm__inputWrapper--password">
                        <span class="rh-loginForm__icon">🔒</span>
                        <input type="password"
                            id="registerConfirmPassword"
                            name="confirmPassword"
                            class="rh-loginForm__input rh-loginForm__input--password"
                            placeholder="••••••••"
                            required />

                        <button type="button"
                                class="rh-loginForm__passwordToggle"
                                data-password-toggle
                                data-toggle-target="registerConfirmPassword"
                                aria-label="Giữ để xem mật khẩu"
                                aria-pressed="false">
                            <svg class="rh-loginForm__passwordIcon"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                aria-hidden="true">
                                <path d="M2 12C3.8 8.8 7.2 6.5 12 6.5C16.8 6.5 20.2 8.8 22 12C20.2 15.2 16.8 17.5 12 17.5C7.2 17.5 3.8 15.2 2 12Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round" />
                                <circle cx="12" cy="12" r="3"
                                        stroke="currentColor"
                                        stroke-width="1.8" />
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="rh-loginForm__submit">Đăng ký</button>

                <div class="rh-loginForm__divider">
                    <span>hoặc</span>
                </div>

                <div class="rh-loginForm__register">
                    Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
                </div>
            </form>
        </div>

    </div>
</section>
