@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideScrollTop"] = true;
    ViewData["BodyClass"] = "body--auth";
}

@await Html.PartialAsync("_AuthNav")

<!-- LOGIN PAGE -->
<section class="rh-loginPage">
    <div class="rh-loginPage__overlay"></div>
    
    <div class="rh-container">
        <div class="rh-loginBox">
            <!-- Logo/Brand -->
            <div class="rh-loginBox__brand">
                <div class="rh-loginBox__brandTop">ROYAL</div>
                <div class="rh-loginBox__brandBot">LUXURY HOTEL</div>
            </div>

            <div class="rh-loginBox__header">
                <h1 class="rh-loginBox__title">Đăng nhập</h1>
                <p class="rh-loginBox__subtitle">Chào mừng bạn trở lại</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="rh-loginBox__error">
                    <span class="rh-loginBox__errorIcon">⚠</span>
                    @ViewBag.ErrorMessage
                </div>
            }

            <form method="post" asp-controller="Account" asp-action="Login" class="rh-loginForm">
                @Html.AntiForgeryToken()
                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Email</label>
                    <div class="rh-loginForm__inputWrapper">
                        <span class="rh-loginForm__icon">✉</span>
                        <input type="email" name="email" class="rh-loginForm__input" placeholder="example@email.com" required />
                    </div>
                </div>

                <div class="rh-loginForm__group">
                    <label class="rh-loginForm__label">Mật khẩu</label>
                    <div class="rh-loginForm__inputWrapper rh-loginForm__inputWrapper--password">
                        <span class="rh-loginForm__icon">🔒</span>
                        <input type="password"
                            id="loginPassword"
                            name="password"
                            class="rh-loginForm__input rh-loginForm__input--password"
                            placeholder="••••••••"
                            required />

                        <button type="button"
                                class="rh-loginForm__passwordToggle"
                                data-password-toggle
                                data-toggle-target="loginPassword"
                                aria-label="Giữ để xem mật khẩu"
                                aria-pressed="false">
                            <svg class="rh-loginForm__passwordIcon"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                aria-hidden="true">
                                <path d="M2 12C3.8 8.8 7.2 6.5 12 6.5C16.8 6.5 20.2 8.8 22 12C20.2 15.2 16.8 17.5 12 17.5C7.2 17.5 3.8 15.2 2 12Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round" />
                                <circle cx="12" cy="12" r="3"
                                        stroke="currentColor"
                                        stroke-width="1.8" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="rh-loginForm__options">
                    <label class="rh-loginForm__remember">
                        <input type="checkbox" name="remember" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="rh-loginForm__forgot">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="rh-loginForm__submit">
                    <span>Đăng nhập</span>
                    <span class="rh-loginForm__submitIcon">→</span>
                </button>

                <div class="rh-loginForm__divider">
                    <span>hoặc</span>
                </div>

                <div class="rh-loginForm__register">
                    Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
                </div>
            </form>

            <!-- Decorative Element -->
            <div class="rh-loginBox__decoration"></div>
        </div>
    </div>
</section>
