@model ROYALHOTEL.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Format tiền thống nhất: 219.5M ₫
    string fmtM(decimal v) => v >= 1_000_000_000
        ? $"{v/1_000_000_000:F2}B ₫"
        : v >= 1_000_000
            ? $"{v/1_000_000:F1}M ₫"
            : $"{v:N0} ₫";

    var years = new[] { 2024, 2025, 2026 };
    var months = new (int v, string label)[] {
        (0,"Tất cả tháng"),(1,"Tháng 1"),(2,"Tháng 2"),(3,"Tháng 3"),
        (4,"Tháng 4"),(5,"Tháng 5"),(6,"Tháng 6"),(7,"Tháng 7"),
        (8,"Tháng 8"),(9,"Tháng 9"),(10,"Tháng 10"),(11,"Tháng 11"),(12,"Tháng 12")
    };
    string periodLabel = Model.SelectedMonth == 0
        ? $"Cả năm {Model.SelectedYear}"
        : $"Tháng {Model.SelectedMonth}/{Model.SelectedYear}";
    string branchLabel = Model.BranchLabel;
}

@section Styles {
<style>
/* ── Filter bar — 1 hàng ngang ──────────────────────────────── */
.dash-filter-bar{
    background:linear-gradient(135deg,#fffdf7,#fff);
    border:1px solid #d9caa7;border-radius:14px;
    padding:16px 22px;
    box-shadow:0 4px 20px rgba(139,106,20,.10);
    margin-bottom:28px
}
.filter-row{display:flex;align-items:flex-end;gap:12px;flex-wrap:nowrap}
.filter-group{display:flex;flex-direction:column;flex:1;min-width:0}
.filter-group.branch{flex:2}
.filter-group.year-g{flex:1}
.filter-group.month-g{flex:1.5}
.filter-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:#8b6a14;margin-bottom:5px}
.dash-filter-bar .form-select{
    border-color:#d9caa7;font-size:14px;min-height:42px;border-radius:8px;
    background-color:#fff;width:100%
}
.dash-filter-bar .form-select:focus{border-color:#8b6a14;box-shadow:0 0 0 3px rgba(139,106,20,.12)}
.dash-apply-btn{
    background:linear-gradient(135deg,#8b6a14,#b8932e);
    color:#fff;border:none;border-radius:8px;padding:0 24px;
    font-weight:700;font-size:14px;height:42px;white-space:nowrap;
    transition:all .2s;flex-shrink:0
}
.dash-apply-btn:hover{background:linear-gradient(135deg,#6d5410,#8b6a14);transform:translateY(-1px);box-shadow:0 4px 14px rgba(139,106,20,.35)}
.filter-period-badge{
    background:rgba(139,106,20,.08);color:#8b6a14;
    border:1px solid rgba(139,106,20,.25);border-radius:20px;
    padding:5px 14px;font-size:12px;font-weight:700;white-space:nowrap;flex-shrink:0
}

/* ── KPI grid — luxury style ─────────────────────────────────── */
.kpi-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:28px}
.kpi-card{
    background:#fff;
    border:1px solid #e8dfc0;
    border-radius:16px;
    padding:22px 18px 18px;
    box-shadow:0 4px 24px rgba(139,106,20,.08);
    transition:all .3s cubic-bezier(.4,0,.2,1);
    position:relative;overflow:hidden;
    cursor:default
}
.kpi-card::before{content:'';position:absolute;top:0;left:0;width:100%;height:3px;border-radius:16px 16px 0 0}
.kpi-card::after{
    content:'';position:absolute;bottom:0;right:0;
    width:80px;height:80px;border-radius:50%;
    opacity:.04;transform:translate(25%,25%)
}
.kpi-net::before    {background:linear-gradient(90deg,#7a5c10,#c9a24a,#f0c14b)}
.kpi-bookings::before{background:linear-gradient(90deg,#1b5e20,#2e7d32,#66bb6a)}
.kpi-occ::before    {background:linear-gradient(90deg,#0d47a1,#1565c0,#42a5f5)}
.kpi-cancel::before {background:linear-gradient(90deg,#b71c1c,#c62828,#ef5350)}
.kpi-refund::before {background:linear-gradient(90deg,#4a148c,#6a1b9a,#ab47bc)}
.kpi-net::after    {background:#c9a24a}
.kpi-bookings::after{background:#2e7d32}
.kpi-occ::after    {background:#1565c0}
.kpi-cancel::after {background:#c62828}
.kpi-refund::after {background:#6a1b9a}
.kpi-card:hover{
    box-shadow:0 16px 40px rgba(139,106,20,.18);
    transform:translateY(-5px)
}
.kpi-icon{
    width:44px;height:44px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-size:20px;margin-bottom:14px
}
.kpi-net .kpi-icon    {background:rgba(139,106,20,.12);color:#8b6a14}
.kpi-bookings .kpi-icon{background:rgba(46,125,50,.12);color:#2e7d32}
.kpi-occ .kpi-icon    {background:rgba(21,101,192,.12);color:#1565c0}
.kpi-cancel .kpi-icon {background:rgba(198,40,40,.12);color:#c62828}
.kpi-refund .kpi-icon {background:rgba(106,27,154,.12);color:#6a1b9a}

.kpi-label{
    font-size:10px;font-weight:800;letter-spacing:1.2px;
    text-transform:uppercase;color:#bbb;margin-bottom:8px
}
.kpi-value{
    font-size:40px;font-weight:900;
    font-family:'Inter','Segoe UI',system-ui,sans-serif;
    color:#1a1a1a;line-height:1.1;
    font-variant-numeric:tabular-nums lining-nums;
    letter-spacing:-1.5px
}
.kpi-sub{font-size:12px;color:#aaa;margin-top:8px;line-height:1.5}
.kpi-sub .pos{color:#2e7d32;font-weight:700}
.kpi-sub .neg{color:#c62828;font-weight:700}

/* ── Chart section ───────────────────────────────────────────── */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px}
.chart-card{background:#fff;border:1px solid #e0d4b0;border-radius:14px;padding:24px;box-shadow:0 4px 18px rgba(139,106,20,.08)}
.chart-title{font-size:17px;font-weight:800;color:#1a1a1a;margin-bottom:20px;display:flex;align-items:center;gap:8px;letter-spacing:.2px}
.chart-title i{color:#8b6a14;font-size:18px}
.chart-period{font-size:12px;color:#aaa;font-weight:500;margin-left:auto}

/* ── Vertical bar chart — TALL & CLEAR ──────────────────────── */
.bar-chart-wrap{position:relative}
.bar-chart{display:flex;align-items:flex-end;gap:5px;height:180px;padding-bottom:4px}
.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;min-width:0;cursor:pointer;position:relative}
.bar-fill{width:85%;border-radius:5px 5px 0 0;transition:height .6s cubic-bezier(.4,0,.2,1);min-height:6px;position:relative}
.bar-fill.rev-bar{background:linear-gradient(180deg,#f0c14b 0%,#c9a24a 40%,#8b6a14 100%)}
.bar-fill:hover{filter:brightness(1.12)}

/* Tooltip on hover */
.bar-fill::after{
    content:attr(data-tip);
    position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);
    background:#1a1a1a;color:#fff;padding:4px 8px;border-radius:6px;
    font-size:11px;font-weight:700;white-space:nowrap;opacity:0;
    pointer-events:none;transition:opacity .15s;z-index:20
}
.bar-fill:hover::after{opacity:1}

.bar-label{font-size:10px;color:#888;margin-top:5px;text-align:center;white-space:nowrap}

/* Gridlines */
.bar-chart-wrap .gridlines{position:absolute;top:0;left:0;right:0;bottom:24px;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none}
.gridlines span{display:block;border-top:1px dashed #f0e8d6;width:100%}

/* Peak highlight */
.bar-col.peak .bar-fill{filter:drop-shadow(0 0 6px rgba(201,162,74,.6))}
.bar-col.peak .bar-label{color:#8b6a14;font-weight:700}

/* ── Horizontal bar (top rooms & occupancy) ─────────────────── */
.hbar-list{display:flex;flex-direction:column;gap:14px}
.hbar-row{display:flex;align-items:center;gap:10px}
.hbar-rank{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;flex-shrink:0}
.rank-1{background:linear-gradient(135deg,#ffd700,#ffb300);color:#1a1a1a}
.rank-2{background:linear-gradient(135deg,#c0c0c0,#9e9e9e);color:#1a1a1a}
.rank-3{background:linear-gradient(135deg,#cd7f32,#a0522d);color:#fff}
.hbar-info{width:100px;flex-shrink:0}
.hbar-code{font-size:13px;font-weight:700;color:#1a1a1a}
.hbar-type{font-size:11px;color:#888}
.hbar-track{flex:1;background:#f5f1e8;border-radius:999px;height:22px;overflow:hidden}
.hbar-fill{height:100%;border-radius:999px;display:flex;align-items:center;padding-left:10px;transition:width .7s ease}
.hbar-fill span{font-size:11px;font-weight:700;color:#fff;white-space:nowrap}
.hbar-fill.gold{background:linear-gradient(90deg,#8b6a14,#c9a24a)}
.hbar-fill.blue{background:linear-gradient(90deg,#1565c0,#42a5f5)}
.hbar-fill.green{background:linear-gradient(90deg,#2e7d32,#66bb6a)}
.hbar-val{width:80px;text-align:right;font-size:13px;font-weight:800;color:#1a1a1a;flex-shrink:0}

/* ── Cancellation bar (double stacked) ──────────────────────── */
.cancel-chart{display:flex;align-items:flex-end;gap:8px;height:160px}
.cancel-col{flex:1;display:flex;flex-direction:column-reverse;align-items:center;gap:2px;cursor:pointer}
.c-bar{width:80%;border-radius:4px 4px 0 0;transition:height .5s ease;min-height:4px;position:relative}
.c-bar::after{content:attr(data-tip);position:absolute;bottom:calc(100%+4px);left:50%;transform:translateX(-50%);
    background:#1a1a1a;color:#fff;padding:3px 8px;border-radius:5px;font-size:10px;white-space:nowrap;
    opacity:0;pointer-events:none;transition:opacity .15s;z-index:20}
.c-bar:hover::after{opacity:1}
.c-cancel{background:linear-gradient(180deg,#ef5350,#c62828)}
.c-refund{background:linear-gradient(180deg,#ab47bc,#6a1b9a)}
.cancel-label{font-size:10px;color:#888;margin-top:5px}
.chart-legend{display:flex;gap:16px;margin-top:12px;flex-wrap:wrap}
.chart-legend span{font-size:12px;display:flex;align-items:center;gap:5px}
.leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}

/* ── Insights ────────────────────────────────────────────────── */
.insights-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px}
.insight-card{border-radius:14px;padding:20px;border-left:4px solid;box-shadow:0 3px 14px rgba(0,0,0,.06);transition:transform .2s}
.insight-card:hover{transform:translateY(-2px)}
.insight-success{border-color:#2e7d32;background:linear-gradient(135deg,#fff,#f3fbef)}
.insight-info   {border-color:#1565c0;background:linear-gradient(135deg,#fff,#f0f6ff)}
.insight-warning{border-color:#e65100;background:linear-gradient(135deg,#fff,#fff8f0)}
.insight-danger {border-color:#c62828;background:linear-gradient(135deg,#fff,#fff5f5)}
.insight-ico{font-size:24px;margin-bottom:10px}
.insight-success .insight-ico{color:#2e7d32}
.insight-info    .insight-ico{color:#1565c0}
.insight-warning .insight-ico{color:#e65100}
.insight-danger  .insight-ico{color:#c62828}
.insight-ttl{font-size:14px;font-weight:800;color:#1a1a1a;margin-bottom:6px}
.insight-bdy{font-size:13px;color:#555;line-height:1.6}

.sec-head{font-size:13px;font-weight:800;color:#8b6a14;text-transform:uppercase;letter-spacing:.8px;margin-bottom:16px;display:flex;align-items:center;gap:8px}

/* ── Full-width Annual Comparison Chart ────────────────────── */
.annual-chart-card{
    background:#fff;
    border:1px solid #e0d4b0;
    border-radius:16px;
    padding:28px 28px 20px;
    box-shadow:0 6px 28px rgba(139,106,20,.10);
    margin-bottom:24px;
    position:relative;overflow:hidden
}
.annual-chart-card::before{
    content:'';
    position:absolute;top:0;left:0;width:100%;height:3px;
    background:linear-gradient(90deg,#7a5c10,#c9a24a,#f0c14b,#c9a24a,#7a5c10)
}
.annual-chart-title{
    font-size:18px;font-weight:800;color:#1a1a1a;
    margin-bottom:6px;display:flex;align-items:center;gap:10px
}
.annual-chart-title i{color:#8b6a14;font-size:20px}
.annual-chart-subtitle{
    font-size:13px;color:#aaa;margin-bottom:24px
}
.annual-chart-subtitle strong{color:#8b6a14}

/* Y-axis + bars wrapper */
.annual-chart-body{display:flex;gap:0;height:220px;align-items:stretch}
.annual-y-axis{
    display:flex;flex-direction:column;justify-content:space-between;
    width:70px;flex-shrink:0;padding-bottom:32px;text-align:right
}
.annual-y-label{font-size:10px;color:#bbb;font-weight:600;padding-right:8px}

.annual-bars-area{flex:1;display:flex;flex-direction:column}
.annual-bars{
    flex:1;
    display:flex;align-items:flex-end;gap:6px;
    border-left:1px solid #f0e8d6;
    border-bottom:1px solid #f0e8d6;
    padding:0 4px 0 8px;
    position:relative
}
/* horizontal gridlines */
.annual-bars::before,
.annual-bars::after{
    content:'';
    position:absolute;left:0;right:0;
    border-top:1px dashed #f5eed8;
    pointer-events:none
}
.annual-bars::before{top:25%}
.annual-bars::after{top:50%}
.annual-bar-col{
    flex:1;display:flex;flex-direction:column;
    align-items:center;gap:0;cursor:pointer;position:relative
}
.annual-bar-fill{
    width:70%;
    border-radius:5px 5px 0 0;
    transition:height .7s cubic-bezier(.4,0,.2,1);
    min-height:8px;
    position:relative;
    background:linear-gradient(180deg,#f0c14b 0%,#c9a24a 35%,#8b6a14 100%);
}
.annual-bar-fill.peak-bar{
    background:linear-gradient(180deg,#ffe082,#f0c14b 20%,#c9a24a 60%,#7a5c10 100%);
    box-shadow:0 0 12px rgba(201,162,74,.5)
}
.annual-bar-fill.low-bar{
    background:linear-gradient(180deg,#d4b896,#b89060,#8b6a38 100%)
}
/* value label on top of bar */
.annual-bar-val{
    font-size:9px;font-weight:700;color:#8b6a14;
    position:absolute;top:-18px;left:50%;transform:translateX(-50%);
    white-space:nowrap;opacity:0;transition:opacity .2s
}
.annual-bar-col:hover .annual-bar-val{opacity:1}
/* tooltip */
.annual-bar-fill::after{
    content:attr(data-tip);
    position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);
    background:#1a1a1a;color:#fff;padding:5px 10px;border-radius:7px;
    font-size:11px;font-weight:700;white-space:nowrap;
    opacity:0;pointer-events:none;transition:opacity .15s;z-index:30
}
.annual-bar-fill:hover::after{opacity:1}

.annual-x-axis{
    display:flex;gap:6px;padding:6px 4px 0 calc(8px);
    border-left:1px solid transparent
}
.annual-x-label{
    flex:1;text-align:center;font-size:10px;color:#999;font-weight:600
}
.annual-x-label.peak-month{color:#8b6a14;font-weight:800}

/* stat strip below chart */
.annual-stat-strip{
    display:flex;gap:0;border-top:1px solid #f5f1e8;
    margin-top:16px;padding-top:14px
}
.annual-stat-item{
    flex:1;text-align:center;padding:0 8px;
    border-right:1px solid #f5f1e8
}
.annual-stat-item:last-child{border-right:none}
.annual-stat-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#bbb;margin-bottom:4px}
.annual-stat-val{font-size:18px;font-weight:900;font-variant-numeric:tabular-nums;color:#1a1a1a}
.annual-stat-val.gold{color:#8b6a14}
.annual-stat-val.red{color:#c62828}
.annual-stat-val.green{color:#2e7d32}

/* Bar value labels — visible by default for annual chart */
.annual-bar-val{opacity:1 !important;font-size:9px;font-weight:700;color:#8b6a14}

/* Responsive */
@@media(max-width:1300px){.kpi-grid{grid-template-columns:repeat(3,1fr)}.kpi-value{font-size:32px}}
@@media(max-width:900px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.charts-grid{grid-template-columns:1fr}.insights-row{grid-template-columns:1fr}}
@@media(max-width:600px){.kpi-grid{grid-template-columns:1fr}}
</style>
}

<!-- ═══════════ FILTER BAR — 1 hàng ngang ═══════════════════════ -->
<form method="get" action="@Url.Action("Index","AdminDashboard")" class="dash-filter-bar">
    <div class="filter-row">
        <div class="filter-group branch">
            <div class="filter-label"><i class="bi bi-building me-1"></i>Chi nhánh</div>
            <select name="hotelId" class="form-select">
                @if (Model.HotelId == 0) { <option value="0" selected>Tất cả chi nhánh</option> }
                else { <option value="0">Tất cả chi nhánh</option> }
                @foreach (var h in Model.Hotels) {
                    if (Model.HotelId == h.Id) { <option value="@h.Id" selected>@h.Name</option> }
                    else { <option value="@h.Id">@h.Name</option> }
                }
            </select>
        </div>
        <div class="filter-group year-g">
            <div class="filter-label"><i class="bi bi-calendar3 me-1"></i>Năm</div>
            <select name="year" class="form-select">
                @foreach (var y in years) {
                    if (Model.SelectedYear == y) { <option value="@y" selected>@y</option> }
                    else { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <div class="filter-group month-g">
            <div class="filter-label"><i class="bi bi-calendar-month me-1"></i>Tháng</div>
            <select name="month" class="form-select">
                @foreach (var (v, label) in months) {
                    if (Model.SelectedMonth == v) { <option value="@v" selected>@label</option> }
                    else { <option value="@v">@label</option> }
                }
            </select>
        </div>
        <button type="submit" class="dash-apply-btn">
            <i class="bi bi-funnel me-2"></i>Áp dụng bộ lọc
        </button>
        <span class="filter-period-badge"><i class="bi bi-clock me-1"></i>@periodLabel</span>
    </div>
</form>

<!-- ═══════════ KPI CARDS ═══════════════════════════════════════ -->
<div class="kpi-grid">
    <div class="kpi-card kpi-net">
        <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
        <div class="kpi-label">Doanh thu thực tế</div>
        <div class="kpi-value">@fmtM(Model.NetRevenue)</div>
        <div class="kpi-sub">
            <span class="pos">+@fmtM(Model.GrossRevenue) doanh thu gộp</span><br>
            <span class="neg">−@fmtM(Model.RefundAmount) hoàn tiền</span>
        </div>
    </div>
    <div class="kpi-card kpi-bookings">
        <div class="kpi-icon"><i class="bi bi-calendar-check"></i></div>
        <div class="kpi-label">Tổng lượt đặt phòng</div>
        <div class="kpi-value">@Model.TotalBookings.ToString("N0")</div>
        <div class="kpi-sub">Lượt đặt phòng • @periodLabel</div>
    </div>
    <div class="kpi-card kpi-occ">
        <div class="kpi-icon"><i class="bi bi-house-door"></i></div>
        <div class="kpi-label">Tỷ lệ lấp phòng</div>
        <div class="kpi-value">@Model.OccupancyRate</div>
        <div class="kpi-sub">Phòng được sử dụng / tổng phòng sẵn có</div>
    </div>
    <div class="kpi-card kpi-cancel">
        <div class="kpi-icon"><i class="bi bi-x-circle"></i></div>
        <div class="kpi-label">Tỷ lệ hủy phòng</div>
        <div class="kpi-value">@Model.CancellationRate</div>
        <div class="kpi-sub">Booking bị hủy / tổng booking</div>
    </div>
    <div class="kpi-card kpi-refund">
        <div class="kpi-icon"><i class="bi bi-arrow-counterclockwise"></i></div>
        <div class="kpi-label">Tổng tiền hoàn</div>
        <div class="kpi-value">@fmtM(Model.RefundAmount)</div>
        <div class="kpi-sub">Hoàn trả cho khách hủy phòng</div>
    </div>
</div>

<!-- ═══════════ SO SÁNH DOANH THU 12 THÁNG ═══════════════════════════ -->
@{
    var ann = Model.AnnualMonthlyRevenue;
    decimal annMax = ann.Any() ? ann.Max(a => a.NetRevenue) : 1;
    decimal annMin = ann.Any() ? ann.Min(a => a.NetRevenue) : 0;
    decimal annSum = ann.Sum(a => a.NetRevenue);
    decimal annAvg = ann.Any() ? annSum / ann.Count : 0;
    int peakMonthIdx = ann.Any() ? ann.Select((a,i)=>(a.NetRevenue,i)).OrderByDescending(x=>x.NetRevenue).First().i : -1;
    int lowMonthIdx  = ann.Any() ? ann.Select((a,i)=>(a.NetRevenue,i)).OrderBy(x=>x.NetRevenue).First().i : -1;
    string yLabel(decimal v) => v >= 1_000_000_000 ? $"{v/1_000_000_000:F1}B" : $"{v/1_000_000:F0}M";
    var yLevels = new[] { annMax, annMax*0.66m, annMax*0.33m, 0m };
}
<div class="annual-chart-card">
    <div class="annual-chart-title">
        <i class="bi bi-bar-chart-steps"></i>
        So sánh doanh thu thực tế theo tháng
    </div>
    <div class="annual-chart-subtitle">
        Năm <strong>@Model.SelectedYear</strong> &nbsp;•&nbsp;
        @branchLabel
        &nbsp;•&nbsp; Net Revenue = Gross − Refund &nbsp;•&nbsp;
        <span style="color:#8b6a14">★ Cột sáng = cao điểm &nbsp; | &nbsp; Cột mờ = thấp điểm</span>
    </div>
    <div class="annual-chart-body">
        <div class="annual-y-axis">
            @foreach (var lv in yLevels) {
                <div class="annual-y-label">@yLabel(lv)</div>
            }
        </div>
        <div class="annual-bars-area">
            <div class="annual-bars">
                @for (int i = 0; i < ann.Count; i++) {
                    var a    = ann[i];
                    var barH = annMax > 0 && a.NetRevenue > 0 ? Math.Max((int)Math.Round(a.NetRevenue / annMax * 100), 1) : 0;
                    var minH = a.NetRevenue > 0 ? "min-height:8px" : "min-height:0; border:none";
                    var cls  = i == peakMonthIdx && a.NetRevenue > 0 ? "peak-bar" : i == lowMonthIdx && a.NetRevenue > 0 ? "low-bar" : "";
                    <div class="annual-bar-col">
                        <div class="annual-bar-val" style="@(a.NetRevenue == 0 ? "color:#ccc" : "")">@fmtM(a.NetRevenue)</div>
                        <div class="annual-bar-fill @cls"
                             style="height:@barH%; @minH; @(a.NetRevenue == 0 ? "background:transparent;" : "")"
                             data-tip="@a.Label: @fmtM(a.NetRevenue)"></div>
                    </div>
                }
            </div>
            <div class="annual-x-axis">
                @for (int i = 0; i < ann.Count; i++) {
                    <div class="annual-x-label @(i==peakMonthIdx?"peak-month":"")">@ann[i].Label</div>
                }
            </div>
        </div>
    </div>
    <div class="annual-stat-strip">
        <div class="annual-stat-item">
            <div class="annual-stat-label">Tổng cả năm</div>
            <div class="annual-stat-val gold">@fmtM(annSum)</div>
        </div>
        <div class="annual-stat-item">
            <div class="annual-stat-label">Trung bình/tháng</div>
            <div class="annual-stat-val">@fmtM(annAvg)</div>
        </div>
        <div class="annual-stat-item">
            <div class="annual-stat-label">🔥 Cao điểm</div>
            <div class="annual-stat-val gold">
                @(ann.Any() ? ann[peakMonthIdx].Label : "-")
                <small style="font-size:13px;color:#aaa">@fmtM(annMax)</small>
            </div>
        </div>
        <div class="annual-stat-item">
            <div class="annual-stat-label">📉 Thấp điểm</div>
            <div class="annual-stat-val red">
                @(ann.Any() ? ann[lowMonthIdx].Label : "-")
                <small style="font-size:13px;color:#aaa">@fmtM(annMin)</small>
            </div>
        </div>
        <div class="annual-stat-item">
            <div class="annual-stat-label">Chênh lệch cao/thấp</div>
            <div class="annual-stat-val">@fmtM(annMax - annMin)</div>
        </div>
    </div>
</div>

<!-- ═══════════ CHARTS 2-COL ════════════════════════════════════ -->
<div class="charts-grid">

    <!-- Chart 1: Đã xóa (trùng với biểu đồ lớn phía trên) -->

    <!-- Chart 2: Top 3 phòng theo doanh thu -->
    @{
        var topRev = Model.TopRooms.Any() ? Model.TopRooms.Max(r => r.NetRevenue) : 1;
        decimal topTotal = Model.TopRooms.Sum(r => r.NetRevenue);
    }
    <div class="chart-card">
        <div class="chart-title">
            <i class="bi bi-trophy-fill"></i>
            Top 3 phòng có doanh thu cao nhất
            <span class="chart-period">@branchLabel</span>
        </div>
        <div class="hbar-list">
            @foreach (var r in Model.TopRooms) {
                var pct    = topRev > 0 ? (int)Math.Round(r.NetRevenue / topRev * 100) : 0;
                var contPct= annSum > 0 ? Math.Round(r.NetRevenue / annSum * 100, 1) : 0;
                var cls    = r.Rank==1?"gold":r.Rank==2?"blue":"green";
                var barStyle = pct > 0 ? $"width:{pct}%" : "width:0%; padding:0; background:transparent";
                var textStyle = pct > 0 ? "" : "color:#888; padding-left:10px";
                <div class="hbar-row">
                    <div class="hbar-rank rank-@r.Rank">@r.Rank</div>
                    <div class="hbar-info">
                        <div class="hbar-code">@r.RoomCode</div>
                        <div class="hbar-type">@r.RoomType • @r.Branch</div>
                    </div>
                    <div class="hbar-track">
                        <div class="hbar-fill @cls" style="@barStyle">
                            <span style="@textStyle">@r.RoomName</span>
                        </div>
                    </div>
                    <div class="hbar-val">
                        <div>@fmtM(r.NetRevenue)</div>
                        <div style="font-size:10px;color:#aaa;font-weight:600">(@contPct%)</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Chart 3: Tỷ lệ lấp phòng — Top 5, sắp xếp giảm dần -->
    <div class="chart-card">
        <div class="chart-title">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            Top phòng có tỷ lệ lấp phòng cao nhất
        </div>
        @{
            var occList = Model.RoomOccupancies.Where(r => r.OccupancyPct > 0).ToList();
        }
        @if (!occList.Any()) {
            <div style="text-align:center; padding: 30px 10px; color: #888;">
                <i class="bi bi-inbox fs-2 mb-2 d-block text-muted"></i>
                <p class="mb-0" style="font-size: 13px;">Chưa có dữ liệu lấp phòng trong kỳ lọc.<br/>Vui lòng kiểm tra chi nhánh, năm/tháng hoặc dữ liệu booking.</p>
            </div>
        } else {
            if (occList.Count < 5) {
                <div style="font-size: 11px; color: #888; font-style: italic; margin-bottom: 12px;">
                    * Một số phòng chưa phát sinh lưu trú trong kỳ lọc.
                </div>
            }
            <div class="hbar-list">
                @foreach (var r in occList.Take(5)) {
                    var pct = (int)Math.Round(r.OccupancyPct);
                    var cls = r.OccupancyPct > 80 ? "gold" : r.OccupancyPct > 65 ? "blue" : "green";
                    var barStyle = pct > 0 ? $"width:{pct}%" : "width:0%; padding:0; background:transparent";
                    var textStyle = pct > 0 ? "" : "color:#888; padding-left:10px";
                    <div class="hbar-row">
                        <div class="hbar-info" style="width:90px">
                            <div class="hbar-code">@r.RoomCode</div>
                            <div class="hbar-type">@r.Branch</div>
                        </div>
                        <div class="hbar-track">
                            <div class="hbar-fill @cls" style="@barStyle">
                                <span style="@textStyle">@(pct > 0 ? r.OccupancyPct.ToString("F0") + "%" : "0%")</span>
                            </div>
                        </div>
                        <div class="hbar-val">@r.OccupancyPct.ToString("F1")%</div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Chart 4: Tỷ lệ hủy theo tháng (chỉ 1 chỉ số) -->
    @{
        var ct = Model.CancellationTrend;
        int maxCancel = ct.Any() && ct.Max(t=>t.Cancelled) > 0 ? ct.Max(t=>t.Cancelled) : 1;
        int totalCancelled = ct.Sum(t=>t.Cancelled);
        int totalBooks2    = ct.Sum(t=>t.TotalBookings);
        decimal cancelRatePct = totalBooks2 > 0 ? Math.Round((decimal)totalCancelled/totalBooks2*100,1) : 0;
    }
    <div class="chart-card">
        <div class="chart-title">
            <i class="bi bi-graph-down-arrow"></i>
            Tỷ lệ hủy phòng theo kỳ
            <span class="chart-period">@periodLabel</span>
        </div>
        <div class="d-flex gap-4 mb-3 align-items-center">
            <div>
                <div style="font-size:10px;font-weight:700;color:#c62828;text-transform:uppercase;letter-spacing:.8px">Tổng lượt hủy</div>
                <div style="font-size:26px;font-weight:900;color:#c62828;font-variant-numeric:tabular-nums">@totalCancelled</div>
            </div>
            <div>
                <div style="font-size:10px;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.8px">Tỷ lệ hủy kỳ này</div>
                <div style="font-size:26px;font-weight:900;color:#888;font-variant-numeric:tabular-nums">@cancelRatePct%</div>
            </div>
        </div>
        <div class="cancel-chart">
            @foreach (var t in ct) {
                var ch = t.Cancelled > 0 ? Math.Max((int)Math.Round((decimal)t.Cancelled / maxCancel * 100), 2) : 0;
                var minH = t.Cancelled > 0 ? "min-height:4px" : "min-height:0; border:none; background:transparent";
                var cancelPct = t.TotalBookings > 0 ? Math.Round((decimal)t.Cancelled/t.TotalBookings*100,1) : 0;
                <div class="cancel-col">
                    <div class="c-bar c-cancel" style="height:@ch%; @minH"
                         data-tip="@t.Label: @t.Cancelled hủy (@cancelPct%)"></div>
                    <div class="cancel-label">@t.Label</div>
                </div>
            }
        </div>
        <div class="chart-legend">
            <span><span class="leg-dot" style="background:#c62828"></span>Số lượt hủy phòng</span>
        </div>
    </div>

    <!-- Chart 5: Doanh thu theo tuần/tháng (Breakdown) -->
    @{
        var mRev = Model.MonthlyRevenue;
        decimal mMax = mRev.Any() && mRev.Max(t=>t.NetRevenue) > 0 ? mRev.Max(t=>t.NetRevenue) : 1;
        decimal mTotal = mRev.Sum(t=>t.NetRevenue);
    }
    <div class="chart-card">
        <div class="chart-title">
            <i class="bi bi-bar-chart-fill"></i>
            @(Model.SelectedMonth == 0 ? "Doanh thu các tháng" : "Doanh thu theo tuần")
            <span class="chart-period">@periodLabel</span>
        </div>
        <div class="d-flex gap-4 mb-3 align-items-center">
            <div>
                <div style="font-size:10px;font-weight:700;color:#2e7d32;text-transform:uppercase;letter-spacing:.8px">Tổng doanh thu kỳ này</div>
                <div style="font-size:26px;font-weight:900;color:#2e7d32;font-variant-numeric:tabular-nums">@fmtM(mTotal)</div>
            </div>
        </div>
        <div class="cancel-chart">
            @foreach (var t in mRev) {
                var ch = t.NetRevenue > 0 ? Math.Max((int)Math.Round((decimal)t.NetRevenue / mMax * 100), 2) : 0;
                var minH = t.NetRevenue > 0 ? "min-height:4px" : "min-height:0; border:none; background:transparent";
                <div class="cancel-col">
                    <div class="c-bar" style="background:linear-gradient(180deg,#66bb6a,#2e7d32); height:@ch%; @minH"
                         data-tip="@t.Label: @fmtM(t.NetRevenue)"></div>
                    <div class="cancel-label" style="font-size:9px">@t.Label</div>
                </div>
            }
        </div>
        <div class="chart-legend">
            <span><span class="leg-dot" style="background:#2e7d32"></span>Doanh thu thực tế (Net)</span>
        </div>
    </div>
</div>

<!-- ═══════════ GỢI Ý QUYẾT ĐỊNH ══════════════════════════════ -->
<div class="sec-head"><i class="bi bi-lightbulb-fill"></i> Gợi ý quyết định</div>
<div class="insights-row">
    @foreach (var ins in Model.Insights) {
        <div class="insight-card insight-@ins.Level">
            <div class="insight-ico"><i class="bi @ins.Icon"></i></div>
            <div class="insight-ttl">@ins.Title</div>
            <div class="insight-bdy">@ins.Body</div>
            <div style="margin-top:10px;display:flex;align-items:center;justify-content:space-between">
                <span style="font-size:11px;color:#aaa;font-weight:600">
                    <strong style="color:#8b6a14">@ins.MetricText</strong>
                </span>
                @{
                    var badge = ins.Level == "success" ? ("Cao","#2e7d32","rgba(46,125,50,.1)") :
                                ins.Level == "info"    ? ("Trung bình","#1565c0","rgba(21,101,192,.1)") :
                                                        ("Quan trọng","#c62828","rgba(198,40,40,.1)");
                }
                <span style="font-size:10px;font-weight:800;padding:2px 8px;border-radius:20px;
                             background:@badge.Item3;color:@badge.Item2">@badge.Item1</span>
            </div>
        </div>
    }
</div>

<!-- Navigation -->
<div class="d-flex justify-content-end gap-2 mb-4">
    <a href="@Url.Action("Index","AdminReports",new{hotelId=Model.HotelId,year=Model.SelectedYear,month=Model.SelectedMonth})"
       class="btn" style="background:linear-gradient(135deg,#8b6a14,#c9a24a);color:#fff;border:none;font-weight:700;padding:11px 22px;border-radius:8px">
        <i class="bi bi-file-earmark-bar-graph me-2"></i>Phân tích chi tiết (Report)
    </a>
</div>
