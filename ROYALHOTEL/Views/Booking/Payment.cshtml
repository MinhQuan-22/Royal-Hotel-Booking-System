@using System.Globalization
@model ROYALHOTEL.Models.Booking

@{
    ViewData["Title"] = "Thanh toán";
    var vi = CultureInfo.GetCultureInfo("vi-VN");

    var roomName = Model.Room?.Name ?? "Phòng";
    var roomCode = Model.Room?.Code ?? "N/A";
    var roomImage = Model.Room?.CoverImageUrl ?? "/assets/rooms/room1.png";
    var checkInText = Model.CheckIn.ToString("dd/MM/yyyy");
    var checkOutText = Model.CheckOut.ToString("dd/MM/yyyy");
    var nights = (Model.CheckOut - Model.CheckIn).Days;
    var pricePerNight = Model.PricePerNight ?? 0;
    var totalAmount = Model.TotalAmount ?? 0;

    var paymentErrorMessage = ViewData["PaymentErrorMessage"]?.ToString()
                              ?? TempData["PaymentErrorMessage"]?.ToString();

    var paymentLocked = false;
    if (ViewData["PaymentLocked"] is bool lockedFlag)
    {
        paymentLocked = lockedFlag;
    }
}

<!-- TOP NAV -->
<section class="rh-payTop">
    <div class="rh-container">
        <header class="rh-nav rh-nav--plain">
            <div class="rh-brand">
                <div class="rh-brand__top">ROYAL</div>
                <div class="rh-brand__bot">LUXURY HOTEL</div>
            </div>

            <nav class="rh-menu">
                <a class="rh-menu__link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="rh-menu__link" asp-controller="Home" asp-action="About">Giới thiệu</a>
                <a class="rh-menu__link" asp-controller="Rooms" asp-action="Index">Phòng &amp; giá</a>
                <a class="rh-menu__link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
            </nav>

            @await Html.PartialAsync("_AccountAvatar")
        </header>
    </div>
</section>

<!-- PAGE -->
<section class="rh-payPage">
    <div class="rh-container rh-payGrid">

        <!-- LEFT: PAYMENT -->
        <div class="rh-payCol">
            <div class="rh-payTitle">
                <span class="rh-payTitle__icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                </span>
                <div class="rh-payTitle__content">
                    <span class="rh-payTitle__text">Thanh toán</span>
                    <span class="rh-payTitle__sub">Hoàn tất đặt phòng của bạn</span>
                </div>
            </div>

            <div class="rh-payBox">
                <div class="rh-payHint">
                    <span class="rh-payHint__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                    </span>
                    <span>Vui lòng kiểm tra thông tin và chọn phương thức thanh toán</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(paymentErrorMessage))
                {
                    <div class="rh-payAlert rh-payAlert--error">
                        @paymentErrorMessage
                    </div>
                }

                <div class="rh-paySection">
                    <div class="rh-paySection__heading">
                        <span class="rh-paySection__icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </span>
                        <span>Thông tin người đặt</span>
                    </div>

                    <div class="rh-infoCard">
                        <div class="rh-infoRow">
                            <span class="rh-infoLabel">
                                <span class="rh-infoIcon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                </span>
                                Họ và tên:
                            </span>
                            <span class="rh-infoValue">@Model.GuestName</span>
                        </div>
                        <div class="rh-infoRow">
                            <span class="rh-infoLabel">
                                <span class="rh-infoIcon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                        <polyline points="22,6 12,13 2,6"></polyline>
                                    </svg>
                                </span>
                                Email:
                            </span>
                            <span class="rh-infoValue">@Model.GuestEmail</span>
                        </div>
                        <div class="rh-infoRow">
                            <span class="rh-infoLabel">
                                <span class="rh-infoIcon">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                                    </svg>
                                </span>
                                Số điện thoại:
                            </span>
                            <span class="rh-infoValue">@Model.GuestPhone</span>
                        </div>
                    </div>
                </div>

                <div class="rh-payDivider"></div>

                @if (paymentLocked)
                {
                    <div class="rh-payLockedBox">
                        <a class="rh-backBtn2" asp-controller="Rooms" asp-action="Index">
                            <span>←</span>
                            <span>Chọn phòng khác</span>
                        </a>
                    </div>
                }
                else
                {
                    <form class="rh-payForm" method="post" asp-controller="Booking" asp-action="Pay" id="paymentForm">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="bookingId" value="@Model.Id" />
                        <input type="hidden" name="paymentMethod" id="paymentMethod" value="bank_transfer" />

                        <div class="rh-paySection">
                            <div class="rh-paySection__heading">
                                <span class="rh-paySection__icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                    </svg>
                                </span>
                                <span>Phương thức thanh toán</span>
                            </div>

                            <label class="rh-payMethod">
                                <input type="radio" name="pm" value="bank_transfer" checked
                                       onchange="setPaymentMethod(this.value)" />
                                <div class="rh-payMethod__icon">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                        <line x1="2" y1="10" x2="22" y2="10"></line>
                                    </svg>
                                </div>
                                <div class="rh-payMethod__body">
                                    <div class="rh-payMethod__title">Chuyển khoản ngân hàng</div>
                                    <div class="rh-payMethod__sub">ZaloPay, VNPAY, Chuyển khoản QR</div>
                                </div>
                            </label>

                            <label class="rh-payMethod">
                                <input type="radio" name="pm" value="card"
                                       onchange="setPaymentMethod(this.value)" />
                                <div class="rh-payMethod__icon">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                                        <line x1="1" y1="10" x2="23" y2="10"></line>
                                    </svg>
                                </div>
                                <div class="rh-payMethod__body">
                                    <div class="rh-payMethod__title">Thẻ tín dụng / Ghi nợ</div>
                                    <div class="rh-payMethod__sub">Visa, MasterCard, JCB</div>
                                </div>
                            </label>
                        </div>

                        <div class="rh-payAgree">
                            <label class="rh-agree">
                                <input type="checkbox" id="agreeTerms" name="agreeTerms" />
                                <span>Tôi đồng ý với <a href="#" class="rh-agree__link">điều khoản &amp; điều kiện</a> của khách sạn</span>
                            </label>
                        </div>

                        <button class="rh-payBtn" type="submit" id="btnPay" disabled>
                            <span class="rh-payBtn__icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </span>
                            <span id="btnPayText">Xác nhận &amp; Thanh toán</span>
                        </button>

                        <a class="rh-backBtn2" asp-controller="Rooms" asp-action="Detail" asp-route-id="@Model.RoomId">
                            <span>←</span>
                            <span>Quay lại</span>
                        </a>
                    </form>
                }
            </div>
        </div>

        <!-- RIGHT: SUMMARY -->
        <aside class="rh-sumCol">
            <div class="rh-sumTitle">
                <span class="rh-sumTitle__icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14,2 14,8 20,8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10,9 9,9 8,9"></polyline>
                    </svg>
                </span>
                <span>Tóm tắt đặt phòng</span>
            </div>

            <div class="rh-sumBox">
                <div class="rh-sumRoomImage">
                    <img src="@roomImage" alt="@roomName" />
                </div>

                <div class="rh-sumHeader">
                    <div class="rh-sumRoomName">
                        <span class="rh-sumRoomIcon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9,22 9,12 15,12 15,22"></polyline>
                            </svg>
                        </span>
                        <span>@roomName</span>
                    </div>
                    <div class="rh-sumRoomNo">Mã phòng: @roomCode</div>
                    <div class="rh-sumRoomNo">Mã giữ chỗ: @Model.BookingCode</div>
                </div>

                <div class="rh-sumMeta">
                    <div class="rh-sumLine">
                        <span>
                            <span class="rh-sumLineIcon">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </span>
                            Check in:
                        </span>
                        <b>@checkInText</b>
                    </div>
                    <div class="rh-sumLine">
                        <span>
                            <span class="rh-sumLineIcon">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </span>
                            Check out:
                        </span>
                        <b>@checkOutText</b>
                    </div>
                    <div class="rh-sumLine">
                        <span>
                            <span class="rh-sumLineIcon">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12,6 12,12 16,14"></polyline>
                                </svg>
                            </span>
                            Số đêm:
                        </span>
                        <b>@nights</b>
                    </div>
                    <div class="rh-sumLine">
                        <span>
                            <span class="rh-sumLineIcon">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            Số người:
                        </span>
                        <b>@Model.Guests</b>
                    </div>
                </div>

                <div class="rh-sumDivider"></div>

                <div class="rh-sumCost">
                    <div class="rh-costRow">
                        <span>@pricePerNight.ToString("N0", vi) VNĐ x @nights đêm</span>
                        <b>@totalAmount.ToString("N0", vi) VNĐ</b>
                    </div>
                    <div class="rh-costRow">
                        <span>Thuế &amp; Phí dịch vụ</span>
                        <b>0 VNĐ</b>
                    </div>
                </div>

                <div class="rh-sumDivider"></div>

                <div class="rh-sumTotal">
                    <span>
                        <span class="rh-sumTotalIcon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </span>
                        Tổng cộng:
                    </span>
                    <b>@totalAmount.ToString("N0", vi) VNĐ</b>
                </div>
            </div>
        </aside>

    </div>
</section>

<style>
    .rh-payAlert {
        padding: 12px 14px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-weight: 600;
    }

    .rh-payAlert--error {
        background: #ffe7e7;
        color: #b42318;
        border: 1px solid #f1b0b0;
    }

    .rh-payLockedBox {
        margin-top: 8px;
    }

    .rh-payBtn[disabled] {
        opacity: 0.7;
        cursor: not-allowed;
    }
</style>

<script>
    function setPaymentMethod(val) {
        const paymentMethodInput = document.getElementById('paymentMethod');
        if (paymentMethodInput) {
            paymentMethodInput.value = val;
        }
    }

    const agree = document.getElementById('agreeTerms');
    const btn = document.getElementById('btnPay');
    const form = document.getElementById('paymentForm');
    const btnPayText = document.getElementById('btnPayText');
    let isSubmitting = false;

    function togglePayButton() {
        if (!agree || !btn) return;

        const ok = agree.checked && !isSubmitting;
        btn.disabled = !ok;
        btn.classList.toggle('is-enabled', ok);
    }

    if (agree) {
        agree.addEventListener('change', togglePayButton);
    }

    if (form) {
        form.addEventListener('submit', function (e) {
            if (isSubmitting) {
                e.preventDefault();
                return false;
            }

            if (!agree || !agree.checked) {
                e.preventDefault();
                togglePayButton();
                return false;
            }

            isSubmitting = true;
            btn.disabled = true;
            btn.classList.remove('is-enabled');

            if (btnPayText) {
                btnPayText.textContent = 'Đang xử lý thanh toán...';
            }
        });
    }

    togglePayButton();
</script>